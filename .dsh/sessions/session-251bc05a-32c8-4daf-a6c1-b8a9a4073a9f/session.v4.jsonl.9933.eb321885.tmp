errors if p.errors else 'none')\ndups=[(k,v) for k,v in collections.Counter(i for i,_ in p.ids).items() if v>1]\nprint('ids:', len(p.ids), 'duplicates:', dups if dups else 'none')\n\n# script extraction\nm=re.search(r'<script>(.*?)</script>', src, re.S)\nopen('/tmp/proto.js','w',encoding='utf-8').write(m.group(1))\nprint('script chars:', len(m.group(1)))\n# css brace balance\ncss=re.search(r'<style>(.*?)</style>', src, re.S).group(1)\nprint('css braces:', css.count('{'), css.count('}'))\nPY\nnode --check /tmp/proto.js && echo \"JS syntax OK\"","startedAt":1793890082664,"toolCall":{"callId":"call_00_gANOFkyL5MWcnZqvxPgw2877","rootCallId":"call_00_gANOFkyL5MWcnZqvxPgw2877"},"finishedAt":1793890082965,"status":"completed","cause":"producer","producerReported":true,"detail":"exit code: 0"}}
