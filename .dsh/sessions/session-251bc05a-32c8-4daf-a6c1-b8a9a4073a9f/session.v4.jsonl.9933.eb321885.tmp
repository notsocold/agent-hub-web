{"type":"job/registered","seq":376,"time":1793891983332,"data":{"jobId":"bash-ed495a9e76034bd8","owner":"session-251bc05a-32c8-4daf-a6c1-b8a9a4073a9f","kind":"bash","label":"cd /home/zhaodan/work/PythonProjects/agent-hub && sed -n '279,305p' docs/database.md && echo \"=== a2a tasks ===\" && grep -n \"### 4.*a2a_tasks\" -A22 docs/database.md | head -30 && echo \"=== knowledge docs ===\" && sed -n '237,270p' docs/database.md","startedAt":1793891983332,"toolCall":{"callId":"call_00_WuDcckg8XQp9L97Zwxoa2445","rootCallId":"call_00_WuDcckg8XQp9L97Zwxoa2445"}}}
