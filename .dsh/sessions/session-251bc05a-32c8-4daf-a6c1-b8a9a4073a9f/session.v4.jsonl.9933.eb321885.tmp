{"type":"job/registered","seq":70,"time":1793890082664,"data":{"jobId":"bash-88dccb8e6ee14e2c","owner":"session-251bc05a-32c8-4daf-a6c1-b8a9a4073a9f","kind":"bash","label":"cd /home/zhaodan/work/NodeJsProjects/agent-hub-web/docs/prototypes && python3 - <<'PY'\nfrom html.parser import HTMLParser\nimport re, collections\n\nsrc = open('ui-v1.html', encoding='utf-8').read()\nVOID = {'area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr','path','circle','rect','line','polyline','polygon','ellipse','use','stop'}\n\nclass P(HTMLParser):\n    def __init__(self):\n        super().__init__(convert_charrefs=True)\n        self.stack=[]; self.errors=[]; self.ids=[]; self.stack_at=[]\n    def handle_starttag(self, tag, attrs):\n        d=dict(attrs)\n        if 'id' in d: self.ids.append((d['id'], self.getpos()))\n        if tag not in VOID:\n            self.stack.append((tag,self.getpos()))\n    def handle_startendtag(self, tag, attrs):\n        d=dict(attrs)\n        if 'id' in d: self.ids.append((d['id'], self.getpos()))\n    def handle_endtag(self, tag):\n        if tag in VOID: return\n        if not self.stack:\n            self.errors.append(f'extra </{tag}> at {self.getpos()}')\n            return\n        if self.stack[-1][0]==tag:\n            self.stack.pop()\n        else:\n            # find match\n            for i in range(len(self.stack)-1,-1,-1):\n                if self.stack[i][0]==tag:\n                    for t in self.stack[i+1:]:\n                        self.errors.append(f'unclosed <{t[0]}> opened at {t[1]}, closed by </{tag}> at {self.getpos()}')\n                    del self.stack[i:]\n                    break\n            else:\n                self.errors.append(f'mismatched </{tag}> at {self.getpos()}, open stack tail={[t[0] for t in self.stack[-4:]]}')\n\np=P(); p.feed(src)\nfor t in p.stack: p.errors.append(f'unclosed <{t[0]}> at {t[1]}')\nprint('tag stack leftovers:', len(p.stack))\nprint('tag errors:', p.errors if p.errors else 'none')\ndups=[(k,v) for k,v in collections.Counter(i for i,_ in p.ids).items() if v>1]\nprint('ids:', len(p.ids), 'duplicates:', dups if dups else 'none')\n\n# script extraction\nm=re.search(r'<script>(.*?)</script>', src, re.S)\nopen('/tmp/proto.js','w',encoding='utf-8').write(m.group(1))\nprint('script chars:', len(m.group(1)))\n# css brace balance\ncss=re.search(r'<style>(.*?)</style>', src, re.S).group(1)\nprint('css braces:', css.count('{'), css.count('}'))\nPY\nnode --check /tmp/proto.js && echo \"JS syntax OK\"","startedAt":1793890082664,"toolCall":{"callId":"call_00_gANOFkyL5MWcnZqvxPgw2877","rootCallId":"call_00_gANOFkyL5MWcnZqvxPgw2877"}}}
