,0,16,0,0,0,0,0,13,0,0,0,0,21,0,0,0,0,0,9,0,0,0,0,0,16,1,0,12,0,0,18,0,0,0,15,21,1,0,13,0,20,0,14,0,0,14,1],"id":"call_00_nKFNJnbsNJDNRdqMhwJW7180","args":["{\"","command","\"",": \"","cd"," /","home","/z","ha","od","an","/work","/","Node","Js","Projects","/","agent","-h","ub","-web","/docs","/pro","t","otypes"," &&"," cp"," ui","-v","5",".html"," ui","-v","5","-p","ages",".html"," &&"," python","3"," -"," <<","'","PY","'\\n","path","='","ui","-v","5","-p","ages",".html","'\\n","s","=","open","(path",",","encoding","='","utf","-","8","').","read","()\\n\\n","def"," rep","(old",",","new",",","count","=","1","):\\n","   "," global"," s","\\n","   "," assert"," old"," in"," s",","," '","M","ISS","ING",":"," '+","old","[:","120","]\\n","   "," s","=s",".replace","(old",",","new",",","count",")\\n\\n","rep","('<","title",">","Agent"," Hub"," ·"," ","对话","工作","台","（","原型"," v","5","）","</","title",">","','","<","title",">","Agent"," Hub"," ·"," ","页面","样例","（","智能","体"," /"," ","任务"," /"," ","知识","库"," /"," ","设置","）","</","title",">","')\\n","rep","('","Agent"," Hub"," UI"," prototype"," v","5"," —"," \\\"","Dispatch"," Desk","\\\"","','","Agent"," Hub"," UI"," prototype"," v","5"," —"," other"," pages","')\\n\\n","#"," ","2","-column"," shell"," (","no"," chat"," trace"," panel",")\\n","rep","('","grid","-template","-column","s",":","var","(--","sidebar","-w",")"," min","max","(","0",",","1","fr",")"," var","(--","trace","-w",");","',\\n","   "," '","grid","-template","-column","s",":","var","(--","sidebar","-w",")"," min","max","(","0",",","1","fr",");","')\\n","rep","('.","app",".s","ide","bar","-coll","apsed","{","grid","-template","-column","s",":","var","(--","sidebar","-","rail",")"," min","max","(","0",",","1","fr",")"," var","(--","trace","-w",")}","',\\n","   "," '.","app",".s","ide","bar","-coll","apsed","{","grid","-template","-column","s",":","var","(--","sidebar","-","rail",")"," min","max","(","0",",","1","fr",")}","')\\n\\n","#"," nav",":"," chat"," links