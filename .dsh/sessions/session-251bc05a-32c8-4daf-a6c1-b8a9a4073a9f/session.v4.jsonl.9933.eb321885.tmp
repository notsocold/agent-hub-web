viewer 过一遍；发布到 #support-weekly 之前先问我。</p>\n              </div>\n            </div>\n\n            <ol class=\"thread\" id=\"thread\">\n\n              <!-- assistant intro -->\n              <li class=\"entry entry-assistant\">\n                <span class=\"node\" aria-hidden=\"true\"></span>\n                <div class=\"entry-head\">\n                  <span class=\"who\">main-agent</span>\n                  <span class=\"who-sub\">调度员 · 计划</span>\n=== trace ===\n          </div>\n          <span class=\"agent-state\"><span class=\"dot is-ok\"></span>在线</span>\n        </div>\n        <div class=\"agent-row\">\n          <span class=\"agent-badge\" aria-hidden=\"true\">ER</span>\n          <div class=\"agent-ident\">\n            <div class=\"agent-name\">editorial-reviewer <span class=\"mono\">a2a</span></div>\n            <div class=\"agent-kind\">review_copy · 空闲</div>\n          </div>\n          <span class=\"agent-state\"><span class=\"dot is-ok\"></span>在线</span>\n        </div>\n        <div class=\"agent-row\">\n          <span class=\"agent-badge\" aria-hidden=\"true\">PB</span>\n          <div class=\"agent-ident\">\n            <div class=\"agent-name\">publisher-agent <span class=\"mono\">a2a</span></div>\n            <div class=\"agent-kind\">publish_report · 写操作</div>\n          </div>\n          <span class=\"agent-state\"><span class=\"dot is-ok\"></span>在线</span>\n        </div>\n      </section>\n\n      <div class=\"trace-foot\">\n        <button class=\"text-link\" data-demo=\"运行事件（原型演示）\">\n          查看运行事件\n          <svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-external\"/></svg>\n        </button>\n      </div>\n    </div>\n  </aside>\n</div>\n\n<div class=\"toast\" id=\"toast\" role=\"status\" aria-live=\"polite\">\n  <svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-check\"/></svg>\n  <span id=\"toastText\"></span>\n</div>\n\n<script>\n(function () {\n  'use strict';\n\n  var root = document.documentElement;\n  var app = document.getElementById('app');\n  var stream = document.getElementById('stream');\n  var conversation = document.getElementById('conversation');\n  var input = document.getElementById('composerInput');\n  var sendBtn = document.getElementById('sendBtn');\n  var toast = document.getElementById('toast');\n  var toastText = document.getElementById('toastText');\n  var approvalCard = document.getElementById('approvalCard');\n  var approvalStatus = document.getElementById('approvalStatus');\n  var resolvedText = document.getElementById('resolvedText');\n  var traceToggle = document.getElementById('traceToggle');\n  var runStatus = document.getElementById('runStatus');\n  var runDot = document.getElementById('runDot');\n  var runStatusText = document.getElementById('runStatusText');\n  var approvalPending = true;\n  var toastTimer = null;\n\n  /* ---------- theme ---------- */\n  try {\n    var savedTheme = localStorage.getItem('ah-theme');\n    if (savedTheme === 'dark' || savedTheme === 'light') root.dataset.theme = savedTheme;\n  } catch (e) { /* file:// storage may be unavailable */ }\n\n  document.getElementById('themeToggle').addEventListener('click', function () {\n    var next = root.dataset.theme === 'dark' ? 'light' : 'dark';\n    root.dataset.theme = next;\n    try { localStorage.setItem('ah-theme', next); } catch (e) {}\n    showToast(next === 'dark' ? '已切换到深色主题' : '已切换到浅色主题');\n  });\n\n  /* ---------- toast ---------- */\n  function showToast(text) {\n    toastText.textContent = text;\n=== composer ===\n          <span class=\"count\">3</span>\n        </div>\n        <ul class=\"cite-list\">\n          <li>\n            <div class=\"cite-top\"><span class=\"cite-name\">Q3 客服复盘 v2</span><span class=\"cite-score\">0.94</span></div>\n            <div class=\"cite-src\">support-kb · 09-30 · 知识库</div>\n          </li>\n          <li>\n            <div class=\"cite-top\"><span class=\"cite-name\">工单分类规范 v3</span><span class=\"cite-score\">0.92</span></div>\n      