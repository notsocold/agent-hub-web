ion:column;align-items:center;gap:5px;\n174:   width:56px;\n175:   padding:9px 0 8px;\n176:   border-radius:7px;\n177:   color:var(--rail-muted);\n178:   font-size:10.5px;\n179:   letter-spacing:.02em;\n180:   transition:color .15s, background .15s;\n181: }\n182: .rail-item .ic{width:20px;height:20px}\n183: .rail-item:hover{color:var(--rail-ink);background:rgba(255,255,255,.05)}\n184: .rail-item.is-active{color:var(--rail-ink);background:rgba(255,255,255,.07)}\n185: .rail-item.is-active::before{\n186:   content:\"\";position:absolute;left:-6px;top:12px;bottom:12px;\n187:   width:2px;border-radius:2px;background:var(--amber);\n188: }\n189: .rail-foot{\n190:   margin-top:auto;\n191:   display:flex;flex-direction:column;align-items:center;gap:10px;\n192:   padding-top:14px;\n193:   border-top:1px solid var(--rail-line);\n194:   width:36px;\n195: }\n196: .rail-icon{\n197:   display:grid;place-items:center;\n198:   width:34px;height:34px;border-radius:7px;\n199:   color:var(--rail-muted);\n200:   transition:color .15s, background .15s;\n201: }\n202: .rail-icon:hover{color:var(--rail-ink);background:rgba(255,255,255,.06)}\n203: .rail-icon .ic{width:17px;height:17px}\n204: html[data-theme=\"dark\"] .ic-sun{display:block}\n205: html[data-theme=\"dark\"] .ic-moon{display:none}\n206: .ic-sun{display:none}\n207: .ic-moon{display:block}\n208: .avatar{\n209:   display:grid;place-items:center;\n210:   width:30px;height:30px;border-radius:50%;\n211:   background:var(--amber);\n212:   color:#191307;\n213:   font-family:var(--font-mono);\n214:   font-size:11px;font-weight:700;\n215:   letter-spacing:.02em;\n216: }\n217: .rail-version{\n218:   font-family:var(--font-mono);\n219:   font-size:9.5px;\n220:   color:var(--rail-muted);\n221:   letter-spacing:.04em;\n222: }\n223: \n224: /* ============================================================\n225:    SESSIONS COLUMN\n226:    ============================================================ */\n227: .sessions{\n228:   display:flex;flex-direction:column;min-height:0;\n229:   background:var(--paper-2);\n230:   border-right:1px solid var(--line);\n231: }\n232: .sessions-head{\n233:   display:flex;align-items:center;justify-content:space-between;gap:8px;\n234:   padding:18px 16px 12px;\n235: }\n236: .sessions-title{font-size:17px;font-weight:650;letter-spacing:-.01em}\n237: .btn-new{\n238:   display:inline-flex;align-items:center;gap:5px;\n239:   height:30px;padding:0 10px;\n240:   border:1px solid var(--line);\n241:   border-radius:6px;\n242:   background:var(--surface);\n243:   color:var(--ink);\n244:   font-size:12px;font-weight:500;\n245:   box-shadow:var(--shadow-sm);\n246:   transition:border-color .15s, background .15s;\n247: }\n248: .btn-new:hover{border-color:var(--ink-3);background:var(--surface)}\n249: .btn-new .ic{width:14px;height:14px}\n250: \n251: .search{\n252:   position:relative;\n253:   display:block;\n254:   margin:0 16px 12px;\n255: }\n256: .search .ic{\n257:   position:absolute;left:10px;top:50%;transform:translateY(-50%);\n258:   width:15px;height:15px;color:var(--ink-3);\n259: }\n260: .search input{\n261:   width:100%;height:34px;\n262:   padding:0 10px 0 32px;\n263:   border:1px solid transparent;\n264:   border-radius:6px;\n265:   background:var(--surface-2);\n266:   color:var(--ink);\n267:   font:inherit;font-size:12.5px;\n268:   outline:none;\n269:   transition:border-color .15s, background .15s;\n270: }\n271: .search input::placeholder{color:var(--ink-3)}\n272: .search input:focus{border-color:var(--line);background:var(--surface)}\n273: \n274: .session-scroll{flex:1;overflow-y:auto;padding:0 8px 12px;min-height:0}\n275: .session-group{padding-top:10px}\n276: .group-label{\n277:   padding:0 10px 6px;\n278:   font-size:11px;font-weight:500;\n279:   color:var(--ink-3);\n280:   letter-spacing:.03em;\n281: }\n282: .session{\n283:   display:block;width:100%;text-align:left;\n284:   padding:9px 10px 9px 12px;\n285:   border-radius:6px;\n286:   border-left:2px solid transparent;\n287:   transition:background .12s;\n288: }\n289: .session:hover{background:rgba(20,27,32,.045)}\n290: html[data-theme=\"dark\"] .session:hover{background:rgba(255,255,255,.04)}\n291: .session.is-active{background:var(--surface);border-left-color:var(--ink);box-shadow:var(--shadow-sm)}\n292: .session-title{\n293:   display:block;\n294:   font-size:13px;font-weight:550;letter-spacing:-.005em;\n295:   white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n296: }\n297: .session.is-active .session-title{font-weight:650}\n298: .session-meta{\n299:   display:flex;align-items:center;gap:6px;\n300:   margin-top:4px;\n301:   font-size:11px;color:var(--ink-3);\n302: }\n303: .session-meta .dot{width:5px;height:5px}\n304: .session-meta .sep{opacity:.5}\n305: \n306: .dot{\n307:   display:inline-block;flex:none;\n308:   width:6px;height:6px;border-radius:50%;\n309:   background:var(--ink-3);\n310: }\n311: .dot.is-live{background:var(--amber);box-shadow:0 0 0 3px var(--amber-soft);animation:pulse 2.4s ease-in-out infinite}\n312: .dot.is-ok{background:var(--green)}\n313: .dot.is-warn{background:var(--red)}\n314: \n315: .sessions-foot{\n316:   flex:none;\n317:   display:flex;align-items:center;justify-content:space-between;gap:8px;\n318:   padding:10px 16px;\n319:   border-top:1px solid var(--line);\n320:   font-size:11px;color:var(--ink-3);\n321: }\n322: .conn{display:flex;align-items:center;gap:7px}\n323: .sessions-foot .mono{font-size:10px;letter-spacing:.02em}\n324: \n325: /* ============================================================\n326:    CHAT COLUMN\n327:    ============================================================ */\n328: .chat{\n329:   display:flex;flex-direction:column;\n\n(Showing lines 130-329 of 2076. Use offset=330 to continue.)\n</content>"}],"isError":false,"id":"1a97b783-4798-4b32-9669-aa3a3fc4ebe9"},"meta":{"path":"/home/zhaodan/work/NodeJsProjects/agent-hub-web/docs/prototypes/ui-v4.html","offset":130,"lines":[{"number":130,"text":"  position:absolute;w