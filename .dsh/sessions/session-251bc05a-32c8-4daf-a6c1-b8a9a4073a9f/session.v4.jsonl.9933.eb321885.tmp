oll","-be","havior","-x",":","contain",";\\n","}\\n",".data","-table","{\\n"," "," width",":","100","%;\\n"," "," min","-width",":","460","px",";\\n"," "," border","-coll","apse",":","collapse",";","\\\"\\\"","\\\")\\n\\n","#"," page"," title"," weight","\\n","rep","(\\\"","\\\"","\\\".","chat","-title","{\\n"," "," font","-size",":","16","px",";","font","-weight",":","650",";","letter","-sp","acing",":-",".","012","em",";","\\\"\\\"","\\\",\\n","\\\"\\\"","\\\".","chat","-title","{\\n"," "," font","-size",":","17","px",";","font","-weight",":","650",";","letter","-sp","acing",":-",".","012","em",";","\\\"\\\"","\\\")\\n\\n","#"," demo","-only"," buttons"," get"," a"," consistent"," toast"," hook","\\n","rep","(\\\"","\\\"\\\"","<","button"," class","=\\\"","icon","-btn","\\\""," title","=\\\"","更多","操作","\\\""," aria","-label","=\\\"","更多","操作","\\\">","\\\"\\\"","\\\",\\n","\\\"\\\"\\\"","<","button"," class","=\\\"","icon","-btn","\\\""," title","=\\\"","更多","操作","\\\""," aria","-label","=\\\"","更多","操作","\\\""," data","-d","emo","=\\\"","更多","操作","（","原型","演示","）","\\\">","\\\"\\\"","\\\")\\n","rep","(\\\"","\\\"\\\"","<","button"," class","=\\\"","com","poser","-t","ool","\\\""," title","=\\\"","添加","附件","\\\">","\\\"\\\"","\\\",\\n","\\\"\\\"\\\"","<","button"," class","=\\\"","com","poser","-t","ool","\\\""," title","=\\\"","添加","附件","\\\""," data","-d","emo","=\\\"","附件","选择","（","原型","演示","）","\\\">","\\\"\\\"","\\\")\\n","rep","(\\\"","\\\"\\\"","<","button"," class","=\\\"","com","poser","-t","ool","\\\""," title","=\\\"","提及","智能","体","\\\">","\\\"\\\"","\\\",\\n","\\\"\\\"\\\"","<","button"," class","=\\\"","com","poser","-t","ool","\\\""," title","=\\\"","提及","智能","体","\\\""," data","-d","emo","=\\\"","智能","体","选择","（","原型","演示","）","\\\">","\\\"\\\"","\\\")\\n","rep","(\\\"","\\\"\\\"","<","button"," class","=\\\"","text","-link","\\\">\\n","          ","查看","完整","运行","日志","\\\"\\\"","\\\",\\n","\\\"\\\"\\\"","<","button"," class","=\\\"","text","-lin