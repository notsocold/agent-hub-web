  s=s.replace(old,new,count)\\n\\n# icons\\nrep('''    <symbol id=\\\"i-archive\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M4 8h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V8Z\\\"/><path d=\\\"M3 4h18v4H3zM10 12h4\\\"/></symbol>''',\\n'''    <symbol id=\\\"i-archive\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M4 8h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V8Z\\\"/><path d=\\\"M3 4h18v4H3zM10 12h4\\\"/></symbol>\\n    <symbol id=\\\"i-menu\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M4 7h16M4 12h16M4 17h16\\\"/></symbol>\\n    <symbol id=\\\"i-more\\\" viewBox=\\\"0 0 24 24\\\"><circle cx=\\\"5\\\" cy=\\\"12\\\" r=\\\"1.3\\\" fill=\\\"currentColor\\\" stroke=\\\"none\\\"/><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"1.3\\\" fill=\\\"currentColor\\\" stroke=\\\"none\\\"/><circle cx=\\\"19\\\" cy=\\\"12\\\" r=\\\"1.3\\\" fill=\\\"currentColor\\\" stroke=\\\"none\\\"/></symbol>\\n    <symbol id=\\\"i-user\\\" viewBox=\\\"0 0 24 24\\\"><circle cx=\\\"12\\\" cy=\\\"8\\\" r=\\\"3.5\\\"/><path d=\\\"M5 20c0-3.6 3.1-5.5 7-5.5s7 1.9 7 5.5\\\"/></symbol>\\n    <symbol id=\\\"i-logout\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4M16 8l4 4-4 4M20 12H9\\\"/></symbol>''')\\n\\n# header heading fills space on mobile\\nrep('.chat-heading{min-width:0}', '.chat-heading{flex:1;min-width:0}')\\n\\n# MCP token restored\\nrep('''  --green:#3D6A4E;\\n  --green-soft:#E4EDE6;\\n''','''  --green:#3D6A4E;\\n  --green-soft:#E4EDE6;\\n  --mcp:#5A4E72;\\n  --mcp-soft:#ECE8F1;\\n''')\\nrep('''  --green:#8DBBA0;\\n  --green-soft:rgba(141,187,160,.12);\\n''','''  --green:#8DBBA0;\\n  --green-soft:rgba(141,187,160,.12);\\n  --mcp:#B3A4C9;\\n  --mcp-soft:rgba(179,164,201,.12);\\n''')\\n\\n# restore styles for skill / MCP cards\\nanchor='@media (prefers-reduced-motion:reduce){'\\nrestored = r'''/* ============================================================\\n   v4: restored capability cards (skill / tool / MCP)\\n   ============================================================ */\\n.kind-sk