te"," limit",")\\n","rep","('","''"," "," var"," approval","Pending"," ="," true",";\\n"," "," var"," toast","Timer"," ="," null",";","''","',\\n","'''"," "," var"," approval","Pending"," ="," true",";\\n"," "," var"," run","Active"," ="," true",";\\n"," "," var"," toast","Timer"," ="," null",";","''","')\\n\\n","rep","('","''"," "," function"," update","Send","State","()"," {\\n","   "," var"," has","Text"," ="," input",".value",".trim","().","length"," >"," ","0",";\\n","   "," send","Btn",".classList",".t","oggle","('","is","-dis","abled","',"," !","has","Text"," ||"," approval","Pending",");\\n","   "," send","Btn",".dis","abled"," ="," !","has","Text"," ||"," approval","Pending",";\\n","   "," send","Btn",".title"," ="," approval","Pending"," ?"," '","请","先","处理","上","方的","发送","审批","'"," :"," '","发送","';\\n"," "," }","''","',\\n","'''"," "," function"," update","Send","State","()"," {\\n","   "," var"," has","Text"," ="," input",".value",".trim","().","length"," >"," ","0",";\\n","   "," var"," blocked"," ="," !","has","Text"," ||"," approval","Pending"," ||"," run","Active",";\\n","   "," send","Btn",".classList",".t","oggle","('","is","-dis","abled","',"," blocked",");\\n","   "," send","Btn",".dis","abled"," ="," blocked",";\\n","   "," send","Btn",".title"," ="," approval","Pending","\\n","     "," ?"," '","请","先","处理","上","方的","发送","审批","'\\n","     "," :"," (","run","Active"," ?"," '","本轮","运行","进行","中","'"," :"," '","发送","');\\n"," "," }","''","')\\n\\n","rep","('","''","     "," if"," (","decision"," ==="," '","appro","ve","')"," {\\n","       "," approval","Status",".text","Content"," ="," '","已","批准","';\\n","       "," approval","Status",".class","Name"," ="," '","status","-chip"," is","-","ok","';\\n","       "," resolved","Text",".text","Content"," ="," '","已","批准","，","主","智能","体","已","恢复","运行","并","调用"," publisher","-agent","。","';\\n","       "," run","Status",".class","Name"," ="," '","status","-chip"," is","-l","ive","';\\n","       "," run","