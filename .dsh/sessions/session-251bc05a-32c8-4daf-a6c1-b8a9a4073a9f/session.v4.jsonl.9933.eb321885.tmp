    autoGrow();"},{"number":2147,"text":"    updateSendState();"},{"number":2148,"text":"    scrollToBottom();"},{"number":2149,"text":""},{"number":2150,"text":"    var reply = makeEntry("},{"number":2151,"text":"      'entry-assistant',"},{"number":2152,"text":"      'main-agent',"},{"number":2153,"text":"      '调度员',"},{"number":2154,"text":"      '<div class=\"prose\"><p class=\"typing\" aria-label=\"正在生成\">· · ·</p></div>'"},{"number":2155,"text":"    );"},{"number":2156,"text":"    thread.appendChild(reply);"},{"number":2157,"text":"    scrollToBottom();"},{"number":2158,"text":""},{"number":2159,"text":"    setTimeout(function () {"},{"number":2160,"text":"      reply.querySelector('.entry-body').innerHTML ="},{"number":2161,"text":"        '<div class=\"prose\"><p>收到，我会把这条补充并入周报，并在下一次发送前再次向你确认。</p></div>';"},{"number":2162,"text":"      scrollToBottom();"},{"number":2163,"text":"    }, 1300);"},{"number":2164,"text":"  }"},{"number":2165,"text":""},{"number":2166,"text":"  /* ---------- copy ---------- */"},{"number":2167,"text":"  function fallbackCopy(text) {"},{"number":2168,"text":"    var ta = document.createElement('textarea');"},{"number":2169,"text":"    ta.value = text;"},{"number":2170,"text":"    ta.setAttribute('readonly', '');"},{"number":2171,"text":"    ta.style.position = 'fixed';"},{"number":2172,"text":"    ta.style.opacity = '0';"},{"number":2173,"text":"    document.body.appendChild(ta);"},{"number":2174,"text":"    ta.select();"}],"totalLines":2211,"lang":"html"}},"sourceEventSeqs":[210],"surfaceOp":"append"}
