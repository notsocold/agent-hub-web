t.textContent = '已拒绝，本轮运行已取消。';\n        runStatus.className = 'status-chip';\n        runDot.className = 'dot';\n        runStatusText.textContent = '已取消';\n        showToast('已拒绝，本轮运行已取消');\n      }\n      updateSendState();''',\n'''      if (decision === 'approve') {\n        approvalStatus.textContent = '已批准';\n        approvalStatus.className = 'status-chip is-ok';\n        resolvedText.textContent = '已批准，主智能体已恢复运行并调用 publisher-agent。';\n        runStatus.className = 'status-chip is-live';\n        runDot.className = 'dot is-live';\n        runStatusText.textContent = '运行中';\n        showToast('已批准，主智能体继续执行');\n        setTimeout(function () {\n          runActive = false;\n          runStatus.className = 'status-chip is-ok';\n          runDot.className = 'dot is-ok';\n          runStatusText.textContent = '已完成';\n          resolvedText.textContent = '已批准，publisher-agent 已发布周报。';\n          updateSendState();\n          showToast('本轮运行已完成，可以继续对话');\n        }, 1800);\n      } else {\n        approvalStatus.textContent = '已拒绝';\n        approvalStatus.className = 'status-chip';\n        resolvedText.textContent = '已拒绝，本轮运行已取消。';\n        runStatus.className = 'status-chip';\n        runDot.className = 'dot';\n        runStatusText.textContent = '已取消';\n        runActive = false;\n        showToast('已拒绝，本轮运行已取消');\n      }\n      updateSendState();''')\n\n# send guard for the single-run limit\nrep('''    if (approvalPending) {\n      showToast('请先处理上方的发送审批');\n      return;\n    }\n\n    var turn = document.createElement('section');''',\n'''    if (approvalPending) {\n      showToast('请先处理上方的发送审批');\n      return;\n    }\n    if (runActive) {\n      showToast('本轮运行进行中，请稍候');\n      return;\n    }\n\n    var turn = document.createElement('section');''')\n\nopen(path,'w',encoding='utf-8').write(s)\nprint('run lifecycle patched')\nPY\npython3 - <<'PY'\nfrom html.parser import HTMLParser\nimport re, collections\nsrc=open('ui-v3.html',encoding='utf-8').read()\nVOID={'area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr','path','circle','rect','line','polyline','polygon','ellipse','use','stop'}\nclass P(HTMLParser):\n    def __init__(self):\n        super().__init__(convert_charrefs=True); self.stack=[]; self.err=[]; self.ids=[]\n    def handle_starttag(self,t,a):\n        d=dict(a)\n        if 'id' in d:self.ids.append(d['id'])\n        if t not in VOID:self.stack.append((t,self.getpos()))\n    def handle_startendtag(self,t,a):\n        d=dict(a)\n        if 'id' in d:self.ids.append(d['id'])\n    def handle_endtag(self,t):\n        if t in VOID:return\n        if not self.stack:self.err.append(('extra',t,self.getpos()));return\n        if self.stack[-1][0]==t:self.stack.pop()\n        else:self.err.append(('mismatch',t,self.getpos(),self.stack[-3:]))\np=P();p.feed(src)\nprint('tag errors:',p.err or 'none')\nprint('unclosed:',p.stack or 'none')\nprint('dup ids:',[k for k,v in collections.Counter(p.ids).items() if v>1] or 'none')\ncss=re.search(r'<style>(.*?)</style>',src,re.S).group(1)\nprint('css braces:',css.count('{'),css.count('}'))\nopen('/tmp/proto3.js','w',encoding='utf-8').write(re.search(r'<script>(.*?)</script>',src,re.S).group(1))\nPY\nnode --check /tmp/proto3.js && echo \"JS syntax OK\"; wc -l ui-v3.html; ls -lh ui-v3.html","startedAt":1793892021488,"toolCall":{"callId":"call_00_N20gnT9hHfXOEpYpTwtC0577","rootCallId":"call_00_N20gnT9hHfXOEpYpTwtC0577"}}}
