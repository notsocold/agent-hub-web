   </div>\\n  </aside>\\n</div>\\n\\n<div class=\\\"toast\\\" id=\\\"toast\\\" role=\\\"status\\\" aria-live=\\\"polite\\\">\\n  <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-check\\\"/></svg>\\n  <span id=\\\"toastText\\\"></span>\\n</div>\\n\\n<script>\\n(function () {\\n  'use strict';\\n\\n  var root = document.documentElement;\\n  var app = document.getElementById('app');\\n  var stream = document.getElementById('stream');\\n  var thread = document.getElementById('thread');\\n  var input = document.getElementById('composerInput');\\n  var sendBtn = document.getElementById('sendBtn');\\n  var toast = document.getElementById('toast');\\n  var toastText = document.getElementById('toastText');\\n  var approvalCard = document.getElementById('approvalCard');\\n  var approvalStatus = document.getElementById('approvalStatus');\\n  var resolvedText = document.getElementById('resolvedText');\\n  var traceToggle = document.getElementById('traceToggle');\\n  var traceClose = document.getElementById('traceClose');\\n  var approvalPending = true;\\n  var toastTimer = null;\\n\\n  /* ---------- theme ---------- */\\n  try {\\n    var savedTheme = localStorage.getItem('ah-theme');\\n    if (savedTheme === 'dark' || savedTheme === 'light') root.dataset.theme = savedTheme;\\n  } catch (e) { /* file:// storage may be unavailable */ }\\n\\n  document.getElementById('themeToggle').addEventListener('click', function () {\\n    var next = root.dataset.theme === 'dark' ? 'light' : 'dark';\\n    root.dataset.theme = next;\\n    try { localStorage.setItem('ah-theme', next); } catch (e) {}\\n    showToast(next === 'dark' ? '已切换到深色主题' : '已切换到浅色主题');\\n  });\\n\\n  /* ---------- toast ---------- */\\n  function showToast(text) {\\n    toastText.textContent = text;\\n    toast.classList.add('is-visible');\\n    clearTimeout(toastTimer);\\n    toastTimer = setTimeout(function () {\\n      toast.classList.remove('is-visible');\\n    }, 2400);\\n  }\\n\\n  /* ---------- trace panel ---------- */\\n  var wide = window.matchMedia('(min-width: 1181px)');\\n\\n  function setTraceExpanded(expanded) {\\n    traceToggle.setAttribute('aria-expanded', String(expanded));\\n  }\\n\\n  traceToggle.addEventListener('click', function () {\\n    if (wide.matches) {\\n      var collapsed = app.classList.toggle('trace-collapsed');\\n      setTraceExpanded(!collapsed);\\n    } else {\\n      var open = app.classList.toggle('trace-open');\\n      setTraceExpanded(open);\\n    }\\n  });\\n\\n  traceClose.addEventListener('click', function () {\\n    if (wide.matches) {\\n      app.classList.add('trace-collapsed');\\n      setTraceExpanded(false);\\n    } else {\\n      app.classList.remove('trace-open');\\n      setTraceExpanded(false);\\n    }\\n  });\\n\\n  wide.addEventListener('change', function () {\\n    app.classList.remove('trace-open');\\n    if (wide.matches) {\\n      app.classList.remove('trace-collapsed');\\n      setTraceExpanded(true);\\n    }\\n  });\\n\\n  /* ---------- session list ---------- */\\n  var sessions = Array.prototype.slice.call(document.querySelectorAll('.session'));\\n  sessions.forEach(function (item) {\\n    item.addEventListener('click', function () {\\n      sessions.forEach(function (s) {\\n        s.classList.remove('is-active');\\n        s.removeAttribute('aria-current');\\n      });\\n      item.classList.add('is-active');\\n      item.setAttribute('aria-current', 'page');\\n    });\\n  });\\n\\n  document.getElementById('newSession').addEventListener('click', function () {\\n    showToast('新会话已创建（原型演示）');\\n  });\\n\\n  var search = document.getElementById('sessionSearch');\\n  search.addEventListener('input', function () {\\n    var q = search.value.trim().toLowerCase();\\n    var groups = document.querySelectorAll('.session-group');\\n    sessions.forEach(function (item) {\\n      var title = item.querySelector('.session-title').textContent.toLowerCase();\\n      item.hidden = q !== '' && title.indexOf(q) === -1;\\n    });\\n    groups.forEach(function (group) {\\n      var visible = Array.prototype.some.call(group.querySelectorAll('.session'), function (s) {\\n        return !s.hidden;\\n      });\\n      group.hidden = !visible;\\n    });\\n  });\\n\\n  /* ---------- approval ---------- */\\n  approvalCard.querySelectorAll('[data-decision]').forEach(function (btn) {\\n    btn.addEventListener('click', function () {\\n      var decision = btn.getAttribute('data-decision');\\n      approvalPending = false;\\n      approvalCard.classList.add('is-resolved');\\n      if (decision === 'approve') {\\n        approvalStatus.textContent = '已批准';\\n        approvalStatus.className = 'status-chip is-ok';\\n        resolvedText.textContent = '已批准，周报已发送到 #support-weekly。';\\n        showToast('已批准并发送到 #support-weekly');\\n      } else {\\n        approvalStatus.textContent = '已拒绝';\\n        approvalStatus.className = 'status-chip';\\n        resolvedText.textContent = '已拒绝，main-agent 不会发送这条消息。';\\n        showToast('已拒绝本次发送');\\n      }\\n      updateSendState();\\n    });\\n  });\\n\\n  /* ---------- cancel task ---------- */\\n  var cancelBtn = document.querySelector('[data-cancel-task]');\\n  if (cancelBtn) {\\n    cancelBtn.addEventListener('click', function () {\\n      cancelBtn.disabled = true;\\n      cancelBtn.textContent = '正在取消…';\\n      setTimeout(function () {\\n        cancelBtn.textContent = '已取消';\\n        showToast('任务 task_7c1e 已取消');\\n      }, 700);\\n    });\\n  }\\n\\n  /* ---------- composer ---------- */\\n  function autoGrow() {\\n    input.style.height = 'auto';\\n    input.style.height = Math.min(input.scrollHeight, 168) + 'px';\\n  }\\n\\n  function updateSendState() {\\n    var hasText = input.value.trim().length > 0;\\n    sendBtn.classList.toggle('is-disabled', !hasText || approvalPending);\\n    sendBtn.disabled = !hasText || approvalPending;\\n    sendBtn.title = approvalPending ? '请先处理上方的发送审批' : '发送';\\n  }\\n\\n  input.addEventListener('input', function () {\\n    autoGrow();\\n    updateSendState();\\n  });\\n\\n  input.addEventListener('keydown', function (event) {\\n    if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {\\n      event.preventDefault();\\n      send();\\n    }\\n  });\\n\\n  sendBtn.addEventListener('click', send);\\n\\n  function nowTime() {\\n    var d = new Date();\\n    return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');\\n  }\\n\\n  function makeEntry(className, who, whoSub, bodyHTML) {\\n    var li = document.createElement('li');\\n    li.className = 'entry ' + className;\\n    li.innerHTML =\\n      '<span class=\\\"node\\\" aria-hidden=\\\"true\\\"></span>' +\\n      '<div class=\\\"entry-head\\\">' +\\n        '<span class=\\\"who\\\"></span>' +\\n        '<span class=\\\"who-sub\\\"></span>' +\\n        '<span class=\\\"spacer\\\"></span>' +\\n        '<time></time>' +\\n      '</div>' +\\n      '<div class=\\\"entry-body\\\"></div>';\\n    li.querySelector('.who').textContent = who;\\n    li.querySelector('.who-sub').textContent = whoSub;\\n    li.querySelector('time').textContent = nowTime();\\n    li.querySelector('.entry-body').innerHTML = bodyHTML;\\n    return li;\\n  }\\n\\n  function scrollToBottom() {\\n    stream.scrollTop = stream.scrollHeight;\\n  }\\n\\n  function send() {\\n    var text = input.value.trim();\\n    if (!text) return;\\n    if (approvalPending) {\\n      showToast('请先处理上方的发送审批');\\n      return;\\n    }\\n\\n    var bubble = document.createElement('p');\\n    bubble.className = 'prompt-bubble';\\n    bubble.textContent = text;\\n    var userEntry = makeEntry('entry-user', '你', '通过 Web 工作台', '');\\n    userEntry.querySelector('.entry-body').appendChild(bubble);\\n    thread.appendChild(userEntry);\\n\\n    input.value = '';\\n    autoGrow();\\n    updateSendState();\\n    scrollToBottom();\\n\\n    var reply = makeEntry(\\n      'entry-assistant',\\n      'main-agent',\\n      '调度员',\\n      '<div class=\\\"prose\\\"><p class=\\\"typing\\\" aria-label=\\\"正在生成\\\">· · ·</p></div>'\\n    );\\n    thread.appendChild(reply);\\n    scrollToBottom();\\n\\n    setTimeout(function () {\\n      reply.querySelector('.entry-body').innerHTML =\\n        '<div class=\\\"prose\\\"><p>收到，我会把这条补充并入周报，并在下一次发送前再次向你确认。</p></div>';\\n      scrollToBottom();\\n    }, 1300);\\n  }\\n\\n  updateSendState();\\n  autoGrow();\\n})();\\n</script>\\n</body>\\n</html>\\n\"}"}}},{"type":"chunk","time":1793890064851,"chunk":{"type":"usage","usage":{"inputTokens":4773,"outputTokens":34922,"cacheReadTokens":30848,"cacheWriteTokens":0,"totalTokens":70543}}},{"type":"chunk","time":1793890064851,"chunk":{"type":"finish","reason":{"kind":"tool-calls"},"replayState":{"response":{"kind":"deepseek-messages","version":1,"model":"deepseek-flash"},"blocks":[{"type":"reasoning","signature":"a759eaa4-861f-48c3-a9ca-70a021ead6ba"},{"type":"text"},{"type":"tool-call"}]}}}]},"surfaceOp":"append"}
{"type":"tool/call","seq":64,"time":1793890064871,"data":{"turn":1,"step":5,"callId":"call_00_O5g4grSLKc3V7Quy7IOL0545","name":"write","arguments":"{\"file_path\": \"/home/zhaodan/work/NodeJsProjects/agent-hub-web/docs/prototypes/ui-v1.html\", \"content\": \"<!doctype html>\\n<html lang=\\\"zh-CN\\\" data-theme=\\\"light\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\" />\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\" />\\n<meta name=\\\"color-scheme\\\" content=\\\"light dark\\\" />\\n<title>Agent Hub · 对话工作台（原型 v1）</title>\\n<style>\\n/* ============================================================\\n   Agent Hub UI prototype v1 — \\\"Dispatch Desk\\\"\\n   npm-free, offline single file. All icons are inline symbols.\\n   ============================================================ */\\n\\n/* ---------- tokens ---------- */\\n:root{\\n  --font-sans: -apple-system, BlinkMacSystemFont, \\\"Segoe UI\\\", \\\"PingFang SC\\\",\\n               \\\"Hiragino Sans GB\\\", \\\"Noto Sans SC\\\", \\\"Source Han Sans SC\\\",\\n               \\\"Microsoft YaHei\\\", sans-serif;\\n  --font-mono: ui-monospace, \\\"SF Mono\\\", \\\"JetBrains Mono\\\", \\\"Cascadia Mono\\\",\\n               \\\"Roboto Mono\\\", Menlo, Consolas, monospace;\\n\\n  --paper:#F0EFE8;\\n  --paper-2:#E9E7DD;\\n  --surface:#FBFAF5;\\n  --surface-2:#F4F3EC;\\n  --ink:#141B20;\\n  --ink-2:#4F5B63;\\n  --ink-3:#606B72;\\n  --line:#D7D5C9;\\n  --line-2:#E3E1D6;\\n\\n  --prussian:#17465E;\\n  --prussian-soft:#E4ECEF;\\n  --amber:#A9741F;\\n  --amber-text:#8A5D14;\\n  --amber-soft:#F3E9D3;\\n  --red:#9C3A2B;\\n  --red-soft:#F6E5E0;\\n  --green:#3D6A4E;\\n  --green-soft:#E4EDE6;\\n\\n  --rail:#13191D;\\n  --rail-ink:#E8E7DE;\\n  --rail-muted:#8C979D;\\n  --rail-line:rgba(255,255,255,.09);\\n\\n  --btn-bg:#141B20;\\n  --btn-fg:#FBFAF5;\\n\\n  --shadow-sm:0 1px 2px rgba(20,27,32,.05);\\n  --shadow-md:0 1px 2px rgba(20,27,32,.04), 0 10px 28px -18px rgba(20,27,32,.35);\\n\\n  --nav-w:68px;\\n  --sessions-w:284px;\\n  --trace-w:332px;\\n}\\n\\nhtml[data-theme=\\\"dark\\\"]{\\n  --paper:#0F1418;\\n  --paper-2:#141A1F;\\n  --surface:#171F24;\\n  --surface-2:#1A2329;\\n  --ink:#E8E7DF;\\n  --ink-2:#A3AEB4;\\n  --ink-3:#85929A;\\n  --line:#2A353C;\\n  --line-2:#212B31;\\n\\n  --prussian:#93BED1;\\n  --prussian-soft:rgba(147,190,209,.12);\\n  --amber:#D4A04A;\\n  --amber-text:#E0B76E;\\n  --amber-soft:rgba(212,160,74,.13);\\n  --red:#DE907E;\\n  --red-soft:rgba(222,144,126,.12);\\n  --green:#8DBBA0;\\n  --green-soft:rgba(141,187,160,.12);\\n\\n  --rail:#080C0F;\\n  --rail-ink:#E8E7DF;\\n  --rail-muted:#849097;\\n\\n  --btn-bg:#E8E7DF;\\n  --btn-fg:#10171B;\\n\\n  --shadow-sm:0 1px 0 rgba(255,255,255,.03);\\n  --shadow-md:0 1px 0 rgba(255,255,255,.03), 0 16px 40px -24px rgba(0,0,0,.9);\\n}\\n\\n/* ---------- base ---------- */\\n*,*::before,*::after{box-sizing:border-box}\\nhtml,body{height:100%}\\nbody{\\n  margin:0;\\n  font-family:var(--font-sans);\\n  font-size:14px;\\n  line-height:1.5;\\n  color:var(--ink);\\n  background:var(--paper);\\n  -webkit-font-smoothing:antialiased;\\n  -moz-osx-font-smoothing:grayscale;\\n  overflow:hidden;\\n}\\nbutton{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}\\na{color:inherit;text-decoration:none}\\nul,ol,dl,dd{margin:0;padding:0;list-style:none}\\nh1,h2,h3,h4,p{margin:0}\\nsvg{display:block}\\n:focus-visible{outline:2px solid var(--prussian);outline-offset:2px;border-radius:3px}\\n::selection{background:var(--amber-soft);color:var(--ink)}\\n\\n*{scrollbar-width:thin;scrollbar-color:var(--line) transparent}\\n::-webkit-scrollbar{width:10px;height:10px}\\n::-webkit-scrollbar-track{background:transparent}\\n::-webkit-scrollbar-thumb{\\n  background:var(--line);\\n  border:3px solid transparent;\\n  background-clip:content-box;\\n  border-radius:99px;\\n}\\n::-webkit-scrollbar-thumb:hover{background-color:var(--ink-3)}\\n\\n.ic{\\n  width:18px;height:18px;flex:none;\\n  fill:none;stroke:currentColor;stroke-width:1.6;\\n  stroke-linecap:round;stroke-linejoin:round;\\n}\\n.mono{font-family:var(--font-mono);font-variant-numeric:tabular-nums}\\n.sr-only{\\n  position:absolute;width:1px;height:1px;padding:0;margin:-1px;\\n  overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;\\n}\\n\\n/* ---------- app shell ---------- */\\n.app{\\n  display:grid;\\n  grid-template-columns:var(--nav-w) var(--sessions-w) minmax(0,1fr) var(--trace-w);\\n  height:100dvh;\\n  min-height:0;\\n  transition:grid-template-columns .22s ease;\\n}\\n.app.trace-collapsed{grid-template-columns:var(--nav-w) var(--sessions-w) minmax(0,1fr) 0px}\\n.app.trace-collapsed .trace{opacity:0;pointer-events:none;overflow:hidden}\\n\\n/* ============================================================\\n   RAIL — the dark spine\\n   ============================================================ */\\n.rail{\\n  display:flex;flex-direction:column;align-items:center;\\n  background:var(--rail);\\n  color:var(--rail-ink);\\n  padding:14px 0 16px;\\n  min-height:0;\\n  z-index:20;\\n}\\n.brand{\\n  display:grid;place-items:center;\\n  width:40px;height:40px;\\n  border-radius:8px;\\n  color:var(--rail-ink);\\n}\\n.brand:hover{background:rgba(255,255,255,.06)}\\n.brand-mark{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}\\n.brand-mark .hot{fill:var(--amber);stroke:none}\\n\\n.rail-nav{\\n  display:flex;flex-direction:column;align-items:center;gap:4px;\\n  margin-top:20px;\\n  width:100%;\\n}\\n.rail-item{\\n  position:relative;\\n  display:flex;flex-direction:column;align-items:center;gap:5px;\\n  width:56px;\\n  padding:9px 0 8px;\\n  border-radius:7px;\\n  color:var(--rail-muted);\\n  font-size:10.5px;\\n  letter-spacing:.02em;\\n  transition:color .15s, background .15s;\\n}\\n.rail-item .ic{width:20px;height:20px}\\n.rail-item:hover{color:var(--rail-ink);background:rgba(255,255,255,.05)}\\n.rail-item.is-active{color:var(--rail-ink);background:rgba(255,255,255,.07)}\\n.rail-item.is-active::before{\\n  content:\\\"\\\";position:absolute;left:-6px;top:12px;bottom:12px;\\n  width:2px;border-radius:2px;background:var(--amber);\\n}\\n.rail-foot{\\n  margin-top:auto;\\n  display:flex;flex-direction:column;align-items:center;gap:10px;\\n  padding-top:14px;\\n  border-top:1px solid var(--rail-line);\\n  width:36px;\\n}\\n.rail-icon{\\n  display:grid;place-items:center;\\n  width:34px;height:34px;border-radius:7px;\\n  color:var(--rail-muted);\\n  transition:color .15s, background .15s;\\n}\\n.rail-icon:hover{color:var(--rail-ink);background:rgba(255,255,255,.06)}\\n.rail-icon .ic{width:17px;height:17px}\\nhtml[data-theme=\\\"dark\\\"] .ic-sun{display:block}\\nhtml[data-theme=\\\"dark\\\"] .ic-moon{display:none}\\n.ic-sun{display:none}\\n.ic-moon{display:block}\\n.avatar{\\n  display:grid;place-items:center;\\n  width:30px;height:30px;border-radius:50%;\\n  background:var(--amber);\\n  color:#191307;\\n  font-family:var(--font-mono);\\n  font-size:11px;font-weight:700;\\n  letter-spacing:.02em;\\n}\\n.rail-version{\\n  font-family:var(--font-mono);\\n  font-size:9.5px;\\n  color:var(--rail-muted);\\n  letter-spacing:.04em;\\n}\\n\\n/* ============================================================\\n   SESSIONS COLUMN\\n   ============================================================ */\\n.sessions{\\n  display:flex;flex-direction:column;min-height:0;\\n  background:var(--paper-2);\\n  border-right:1px solid var(--line);\\n}\\n.sessions-head{\\n  display:flex;align-items:center;justify-content:space-between;gap:8px;\\n  padding:18px 16px 12px;\\n}\\n.sessions-title{font-size:17px;font-weight:650;letter-spacing:-.01em}\\n.btn-new{\\n  display:inline-flex;align-items:center;gap:5px;\\n  height:30px;padding:0 10px;\\n  border:1px solid var(--line);\\n  border-radius:6px;\\n  background:var(--surface);\\n  color:var(--ink);\\n  font-size:12px;font-weight:500;\\n  box-shadow:var(--shadow-sm);\\n  transition:border-color .15s, background .15s;\\n}\\n.btn-new:hover{border-color:var(--ink-3);background:var(--surface)}\\n.btn-new .ic{width:14px;height:14px}\\n\\n.search{\\n  position:relative;\\n  display:block;\\n  margin:0 16px 12px;\\n}\\n.search .ic{\\n  position:absolute;left:10px;top:50%;transform:translateY(-50%);\\n  width:15px;height:15px;color:var(--ink-3);\\n}\\n.search input{\\n  width:100%;height:34px;\\n  padding:0 10px 0 32px;\\n  border:1px solid transparent;\\n  border-radius:6px;\\n  background:var(--surface-2);\\n  color:var(--ink);\\n  font:inherit;font-size:12.5px;\\n  outline:none;\\n  transition:border-color .15s, background .15s;\\n}\\n.search input::placeholder{color:var(--ink-3)}\\n.search input:focus{border-color:var(--line);background:var(--surface)}\\n\\n.session-scroll{flex:1;overflow-y:auto;padding:0 8px 12px;min-height:0}\\n.session-group{padding-top:10px}\\n.group-label{\\n  padding:0 10px 6px;\\n  font-size:11px;font-weight:500;\\n  color:var(--ink-3);\\n  letter-spacing:.03em;\\n}\\n.session{\\n  display:block;width:100%;text-align:left;\\n  padding:9px 10px 9px 12px;\\n  border-radius:6px;\\n  border-left:2px solid transparent;\\n  transition:background .12s;\\n}\\n.session:hover{background:rgba(20,27,32,.045)}\\nhtml[data-theme=\\\"dark\\\"] .session:hover{background:rgba(255,255,255,.04)}\\n.session.is-active{background:var(--surface);border-left-color:var(--ink);box-shadow:var(--shadow-sm)}\\n.session-title{\\n  display:block;\\n  font-size:13px;font-weight:550;letter-spacing:-.005em;\\n  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\\n}\\n.session.is-active .session-title{font-weight:650}\\n.session-meta{\\n  display:flex;align-items:center;gap:6px;\\n  margin-top:4px;\\n  font-size:11px;color:var(--ink-3);\\n}\\n.session-meta .dot{width:5px;height:5px}\\n.session-meta .sep{opacity:.5}\\n\\n.dot{\\n  display:inline-block;flex:none;\\n  width:6px;height:6px;border-radius:50%;\\n  background:var(--ink-3);\\n}\\n.dot.is-live{background:var(--amber);box-shadow:0 0 0 3px var(--amber-soft);animation:pulse 2.4s ease-in-out infinite}\\n.dot.is-ok{background:var(--green)}\\n.dot.is-warn{background:var(--red)}\\n\\n.sessions-foot{\\n  flex:none;\\n  display:flex;align-items:center;justify-content:space-between;gap:8px;\\n  padding:10px 16px;\\n  border-top:1px solid var(--line);\\n  font-size:11px;color:var(--ink-3);\\n}\\n.conn{display:flex;align-items:center;gap:7px}\\n.sessions-foot .mono{font-size:10px;letter-spacing:.02em}\\n\\n/* ============================================================\\n   CHAT COLUMN\\n   ============================================================ */\\n.chat{\\n  display:flex;flex-direction:column;\\n  min-width:0;min-height:0;\\n  background:var(--paper);\\n  position:relative;\\n}\\n.chat-head{\\n  flex:none;\\n  display:flex;align-items:center;justify-content:space-between;gap:20px;\\n  min-height:68px;\\n  padding:0 32px;\\n  border-bottom:1px solid var(--line);\\n  background:var(--paper);\\n}\\n.chat-heading{min-width:0}\\n.chat-title{\\n  font-size:16px;font-weight:650;letter-spacing:-.012em;\\n  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\\n}\\n.chat-sub{\\n  display:flex;align-items:center;gap:8px;\\n  margin-top:3px;\\n  font-size:11.5px;color:var(--ink-3);\\n  white-space:nowrap;overflow:hidden;\\n}\\n.chat-sub .mono{font-size:10.5px;color:var(--ink-3)}\\n.chat-sub .sep{opacity:.45}\\n.chat-actions{display:flex;align-items:center;gap:8px;flex:none}\\n\\n.status-chip{\\n  display:inline-flex;align-items:center;gap:6px;\\n  height:26px;padding:0 9px;\\n  border:1px solid var(--line);\\n  border-radius:5px;\\n  background:var(--surface);\\n  color:var(--ink-2);\\n  font-size:11.5px;font-weight:500;\\n  white-space:nowrap;\\n}\\n.status-chip .dot{width:5px;height:5px}\\n.status-chip.is-live{border-color:var(--amber-soft);background:var(--amber-soft);color:var(--amber-text)}\\n.status-chip.is-warn{border-color:var(--red-soft);background:var(--red-soft);color:var(--red)}\\n.status-chip.is-ok{border-color:var(--green-soft);background:var(--green-soft);color:var(--green)}\\n\\n.icon-btn{\\n  display:grid;place-items:center;\\n  width:30px;height:30px;\\n  border:1px solid var(--line);\\n  border-radius:5px;\\n  background:var(--surface);\\n  color:var(--ink-2);\\n  transition:color .15s,border-color .15s;\\n}\\n.icon-btn:hover{color:var(--ink);border-color:var(--ink-3)}\\n.icon-btn .ic{width:16px;height:16px}\\n\\n.stream{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden}\\n.stream-inner{\\n  max-width:812px;\\n  margin:0 auto;\\n  padding:30px 36px 16px;\\n}\\n\\n/* ---------- timeline bus ---------- */\\n.thread{position:relative;padding-bottom:6px}\\n.thread::before{\\n  content:\\\"\\\";\\n  position:absolute;left:21px;top:10px;bottom:14px;\\n  width:1px;\\n  background:var(--line);\\n}\\n.entry{position:relative;padding-left:52px;margin-bottom:26px}\\n.entry:last-child{margin-bottom:8px}\\n.node{\\n  position:absolute;left:17.5px;top:5px;\\n  width:8px;height:8px;\\n  background:var(--paper);\\n  border:1.5px solid var(--ink-2);\\n  border-radius:50%;\\n  z-index:1;\\n}\\n.entry-user .node{background:var(--ink);border-color:var(--ink)}\\n.entry-tool .node{\\n  border-radius:1.5px;border-color:var(--amber);background:var(--surface);\\n}\\n.entry-a2a .node{\\n  border-radius:1px;border-color:var(--prussian);\\n  transform:rotate(45deg);background:var(--prussian-soft);\\n}\\n.entry-approval .node{border-color:var(--red);background:var(--red-soft)}\\n\\n.entry-head{\\n  display:flex;align-items:baseline;gap:9px;\\n  min-height:18px;\\n  margin-bottom:7px;\\n}\\n.who{font-size:12.5px;font-weight:650;letter-spacing:-.005em}\\n.who-sub{font-size:11px;color:var(--ink-3)}\\n.entry-head time{\\n  font-family:var(--font-mono);\\n  font-size:10.5px;color:var(--ink-3);\\n  letter-spacing:.01em;\\n}\\n.entry-head .spacer{flex:1}\\n.copy-btn{\\n  display:inline-flex;align-items:center;gap:4px;\\n  font-size:11px;color:var(--ink-3);\\n  opacity:0;transition:opacity .15s,color .15s;\\n}\\n.entry:hover .copy-btn,.copy-btn:focus-visible{opacity:1}\\n.copy-btn:hover{color:var(--ink)}\\n.copy-btn .ic{width:13px;height:13px}\\n\\n/* user message */\\n.prompt-bubble{\\n  display:inline-block;\\n  max-width:100%;\\n  padding:12px 16px;\\n  border:1px solid var(--line-2);\\n  border-radius:7px;\\n  background:var(--surface-2);\\n  font-size:14.5px;line-height:1.7;\\n  color:var(--ink);\\n}\\n.attachments{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}\\n.attach{\\n  display:inline-flex;align-items:center;gap:7px;\\n  height:28px;padding:0 10px;\\n  border:1px solid var(--line);\\n  border-radius:5px;\\n  background:var(--surface);\\n  font-size:11.5px;color:var(--ink-2);\\n}\\n.attach .ic{width:14px;height:14px;color:var(--ink-3)}\\n.attach .mono{font-size:10.5px;color:var(--ink-3)}\\n\\n/* assistant prose */\\n.prose{font-size:14.5px;line-height:1.78;color:var(--ink)}\\n.prose > * + *{margin-top:13px}\\n.prose h3{\\n  font-size:19px;font-weight:650;letter-spacing:-.018em;line-height:1.35;\\n  margin-top:2px;\\n}\\n.prose h4{\\n  font-size:13.5px;font-weight:650;letter-spacing:.005em;\\n  color:var(--ink);\\n  margin-top:22px;\\n}\\n.prose strong{font-weight:650}\\n.prose p{max-width:68ch}\\n.prose .cite{\\n  display:inline-grid;place-items:center;\\n  min-width:14px;height:14px;\\n  margin-left:2px;padding:0 3px;\\n  border-radius:3px;\\n  background:var(--prussian-soft);\\n  color:var(--prussian);\\n  font-family:var(--font-mono);\\n  font-size:9px;font-weight:600;\\n  vertical-align:2px;\\n  line-height:1;\\n}\\n.prose blockquote{\\n  margin:18px 0 0;\\n  padding:2px 0 2px 14px;\\n  border-left:2px solid var(--line);\\n  color:var(--ink-2);\\n  font-size:13px;line-height:1.75;\\n}\\n.prose ul{max-width:66ch;padding-left:0}\\n.prose ul li{\\n  position:relative;\\n  padding-left:16px;\\n  margin-top:7px;\\n}\\n.prose ul li::before{\\n  content:\\\"\\\";\\n  position:absolute;left:2px;top:.72em;\\n  width:4px;height:1px;\\n  background:var(--ink-3);\\n}\\n.prose code{\\n  font-family:var(--font-mono);\\n  font-size:.9em;\\n  padding:1px 4px;\\n  border-radius:3px;\\n  background:var(--surface-2);\\n  border:1px solid var(--line-2);\\n}\\n\\n/* data table */\\n.data-table{\\n  width:100%;\\n  margin-top:16px;\\n  border-collapse:collapse;\\n  font-size:13px;\\n  font-variant-numeric:tabular-nums;\\n}\\n.data-table caption{\\n  text-align:left;\\n  font-size:11px;color:var(--ink-3);\\n  padding-bottom:7px;\\n}\\n.data-table th{\\n  text-align:left;\\n  padding:7px 8px;\\n  font-size:11px;font-weight:500;\\n  color:var(--ink-3);\\n  letter-spacing:.02em;\\n  border-bottom:1px solid var(--line);\\n  white-space:nowrap;\\n}\\n.data-table th.num,.data-table td.num{text-align:right}\\n.data-table td{\\n  padding:9px 8px;\\n  border-bottom:1px solid var(--line-2);\\n  color:var(--ink-2);\\n}\\n.data-table td:first-child{color:var(--ink);font-weight:500}\\n.data-table tr:last-child td{border-bottom:1px solid var(--line)}\\n.data-table .delta-up{color:var(--red)}\\n.data-table .delta-down{color:var(--green)}\\n\\n/* ---------- tool card ---------- */\\n.tool-card{\\n  border:1px solid var(--line-2);\\n  border-radius:6px;\\n  background:var(--surface);\\n  box-shadow:var(--shadow-sm);\\n  overflow:hidden;\\n}\\n.tool-card summary{\\n  display:flex;align-items:center;gap:10px;\\n  padding:9px 12px;\\n  cursor:pointer;\\n  list-style:none;\\n  user-select:none;\\n}\\n.tool-card summary::-webkit-details-marker{display:none}\\n.tool-card summary:hover{background:var(--surface-2)}\\n.tool-name{\\n  font-family:var(--font-mono);\\n  font-size:12px;font-weight:500;\\n  color:var(--ink);\\n  white-space:nowrap;\\n}\\n.tool-args{\\n  font-family:var(--font-mono);\\n  font-size:11.5px;color:var(--ink-3);\\n  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\\n  flex:1;min-width:0;\\n}\\n.tool-result{\\n  display:inline-flex;align-items:center;gap:4px;\\n  font-size:11px;font-weight:500;color:var(--green);\\n  white-space:nowrap;\\n}\\n.tool-result .ic{width:12px;height:12px;stroke-width:2}\\n.tool-time{\\n  font-family:var(--font-mono);\\n  font-size:10.5px;color:var(--ink-3);\\n  white-space:nowrap;\\n}\\n.chev{width:14px;height:14px;color:var(--ink-3);transition:transform .18s}\\n.tool-card[open] .chev{transform:rotate(180deg)}\\n.tool-body{\\n  border-top:1px solid var(--line-2);\\n  padding:9px 12px 11px;\\n  background:var(--surface-2);\\n}\\n.hit{\\n  display:flex;align-items:baseline;gap:8px;\\n  padding:5px 0;\\n  font-size:12px;\\n  border-bottom:1px dashed var(--line-2);\\n}\\n.hit:last-child{border-bottom:0}\\n.hit-title{color:var(--ink);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\\n.hit-score{font-family:var(--font-mono);font-size:10.5px;color:var(--prussian)}\\n.hit-date{font-family:var(--font-mono);font-size:10px;color:var(--ink-3)}\\n.tool-note{\\n  margin-top:7px;\\n  font-family:var(--font-mono);\\n  font-size:10px;color:var(--ink-3);\\n}\\n\\n/* ---------- A2A task card ---------- */\\n.a2a-card{\\n  border:1px solid var(--line);\\n  border-left:3px solid var(--amber);\\n  border-radius:6px;\\n  background:var(--surface);\\n  box-shadow:var(--shadow-sm);\\n  overflow:hidden;\\n}\\n.a2a-top{display:flex;align-items:flex-start;gap:11px;padding:13px 15px 11px}\\n.agent-badge{\\n  display:grid;place-items:center;flex:none;\\n  width:28px;height:28px;\\n  border:1px solid var(--line);\\n  border-radius:5px;\\n  background:var(--surface-2);\\n  font-family:var(--font-mono);\\n  font-size:11px;font-weight:700;\\n  color:var(--prussian);\\n}\\n.a2a-ident{flex:1;min-width:0}\\n.a2a-name{\\n  display:flex;align-items:center;gap:8px;\\n  font-size:13px;font-weight:650;letter-spacing:-.005em;\\n}\\n.tag{\\n  display:inline-flex;align-items:center;\\n  height:17px;padding:0 5px;\\n  border:1px solid var(--line);\\n  border-radius:3px;\\n  font-family:var(--font-mono);\\n  font-size:9.5px;font-weight:400;\\n  color:var(--ink-3);\\n  white-space:nowrap;\\n}\\n.a2a-task{margin-top:3px;font-size:12px;color:var(--ink-2)}\\n.a2a-status{\\n  display:inline-flex;align-items:center;gap:6px;\\n  font-size:11.5px;font-weight:500;color:var(--amber-text);\\n  white-space:nowrap;\\n}\\n.progress{\\n  height:3px;\\n  margin:0 15px;\\n  border-radius:99px;\\n  background:var(--line-2);\\n  overflow:hidden;\\n}\\n.progress span{\\n  display:block;height:100%;\\n  border-radius:99px;\\n  background:var(--amber);\\n  transition:width .4s ease;\\n}\\n.steps{\\n  display:flex;flex-wrap:wrap;align-items:center;\\n  gap:0 6px;\\n  padding:10px 15px 9px;\\n  font-size:11px;color:var(--ink-3);\\n}\\n.steps .step{display:inline-flex;align-items:center;gap:4px;white-space:nowrap}\\n.steps .step .ic{width:11px;height:11px;stroke-width:2.2}\\n.steps .step.is-done{color:var(--ink-2)}\\n.steps .step.is-now{color:var(--amber-text);font-weight:500}\\n.steps .step.is-now .dot{width:4px;height:4px;background:var(--amber)}\\n.steps .arrow{width:11px;height:11px;color:var(--line);stroke-width:2}\\n.a2a-foot{\\n  display:flex;align-items:center;gap:10px;\\n  padding:8px 15px;\\n  border-top:1px solid var(--line-2);\\n  background:var(--surface-2);\\n  font-family:var(--font-mono);\\n  font-size:10px;color:var(--ink-3);\\n}\\n.a2a-foot .spacer{flex:1}\\n.btn-ghost{\\n  display:inline-flex;align-items:center;gap:5px;\\n  height:24px;padding:0 8px;\\n  border:1px solid var(--line);\\n  border-radius:4px;\\n  background:var(--surface);\\n  font-family:var(--font-sans);\\n  font-size:11px;color:var(--ink-2);\\n  transition:color .15s,border-color .15s;\\n}\\n.btn-ghost:hover{color:var(--ink);border-color:var(--ink-3)}\\n.btn-ghost .ic{width:12px;height:12px}\\n\\n/* ---------- approval card ---------- */\\n.approval-card{\\n  border:1px solid var(--line);\\n  border-left:3px solid var(--red);\\n  border-radius:6px;\\n  background:var(--surface);\\n  box-shadow:var(--shadow-sm);\\n  overflow:hidden;\\n}\\n.approval-head{\\n  display:flex;align-items:center;gap:8px;\\n  padding:13px 15px 0;\\n}\\n.approval-head .ic{width:15px;height:15px;color:var(--red)}\\n.approval-title{font-size:13px;font-weight:650;letter-spacing:-.005em}\\n.approval-head .status-chip{margin-left:auto;height:22px;font-size:10.5px;padding:0 7px}\\n.approval-body{padding:8px 15px 14px}\\n.approval-action{font-size:13.5px;line-height:1.6;color:var(--ink)}\\n.approval-action b{font-weight:650}\\n.risk-list{\\n  display:grid;grid-template-columns:auto 1fr;\\n  gap:3px 12px;\\n  margin-top:11px;\\n  font-size:11.5px;\\n}\\n.risk-list dt{color:var(--ink-3)}\\n.risk-list dd{color:var(--ink-2)}\\n.approval-actions{\\n  display:flex;align-items:center;gap:8px;\\n  padding:10px 15px;\\n  border-top:1px solid var(--line-2);\\n  background:var(--surface-2);\\n}\\n.approval-actions .spacer{flex:1}\\n.btn{\\n  display:inline-flex;align-items:center;justify-content:center;gap:6px;\\n  height:31px;padding:0 13px;\\n  border-radius:5px;\\n  font-size:12.5px;font-weight:550;\\n  transition:background .15s,color .15s,border-color .15s;\\n  white-space:nowrap;\\n}\\n.btn .ic{width:14px;height:14px}\\n.btn-primary{background:var(--btn-bg);color:var(--btn-fg);border:1px solid var(--btn-bg)}\\n.btn-primary:hover{background:var(--prussian);border-color:var(--prussian);color:#FBFAF5}\\nhtml[data-theme=\\\"dark\\\"] .btn-primary:hover{background:var(--amber);border-color:var(--amber);color:#141B20}\\n.btn-outline{background:transparent;color:var(--ink-2);border:1px solid var(--line)}\\n.btn-outline:hover{color:var(--ink);border-color:var(--ink-3)}\\n.btn[disabled]{opacity:.42;cursor:not-allowed}\\n.approval-card.is-resolved .approval-actions{display:none}\\n.approval-card.is-resolved{border-left-color:var(--green)}\\n.approval-card.is-resolved .approval-head .ic{color:var(--green)}\\n.resolved-note{\\n  display:none;\\n  align-items:center;gap:7px;\\n  padding:10px 15px;\\n  border-top:1px solid var(--line-2);\\n  background:var(--green-soft);\\n  font-size:11.5px;color:var(--green);\\n}\\n.approval-card.is-resolved .resolved-note{display:flex}\\n.resolved-note .ic{width:14px;height:14px}\\n\\n/* thread footer */\\n.thread-foot{\\n  display:flex;align-items:center;gap:8px;\\n  margin-left:52px;\\n  padding-top:2px;\\n  font-size:11px;color:var(--ink-3);\\n}\\n.thread-foot .mono{font-size:10px}\\n.thread-foot::before{\\n  content:\\\"\\\";\\n  width:18px;height:1px;background:var(--line);\\n}\\n\\n/* ---------- composer ---------- */\\n.composer-wrap{\\n  flex:none;\\n  padding:10px 32px 14px;\\n  background:linear-gradient(var(--paper) 0%, var(--paper) 100%);\\n}\\n.composer-inner{max-width:812px;margin:0 auto}\\n.composer{\\n  border:1px solid var(--line);\\n  border-radius:9px;\\n  background:var(--surface);\\n  box-shadow:var(--shadow-md);\\n  transition:border-color .15s;\\n}\\n.composer:focus-within{border-color:var(--ink-3)}\\n.composer textarea{\\n  display:block;width:100%;\\n  min-height:48px;max-height:168px;\\n  padding:13px 15px 4px;\\n  border:0;outline:none;resize:none;\\n  background:transparent;\\n  color:var(--ink);\\n  font:inherit;font-size:14px;line-height:1.65;\\n}\\n.composer textarea::placeholder{color:var(--ink-3)}\\n.composer-bar{\\n  display:flex;align-items:center;gap:6px;\\n  padding:5px 8px 7px 9px;\\n}\\n.composer-tool{\\n  display:inline-flex;align-items:center;gap:5px;\\n  height:27px;padding:0 8px;\\n  border-radius:4px;\\n  color:var(--ink-3);\\n  font-size:11.5px;\\n  transition:background .15s,color .15s;\\n}\\n.composer-tool:hover{background:var(--surface-2);color:var(--ink)}\\n.composer-tool .ic{width:14px;height:14px}\\n.model-chip{\\n  display:inline-flex;align-items:center;gap:5px;\\n  height:23px;padding:0 7px;\\n  margin-left:2px;\\n  border:1px solid var(--line-2);\\n  border-radius:4px;\\n  font-family:var(--font-mono);\\n  font-size:10px;color:var(--ink-3);\\n  white-space:nowrap;\\n}\\n.model-chip .dot{width:4px;height:4px;background:var(--green)}\\n.composer-bar .spacer{flex:1}\\n.send{\\n  display:grid;place-items:center;\\n  width:32px;height:32px;\\n  border-radius:6px;\\n  background:var(--btn-bg);\\n  color:var(--btn-fg);\\n  transition:opacity .15s,background .15s;\\n}\\n.send:hover{background:var(--prussian)}\\nhtml[data-theme=\\\"dark\\\"] .send:hover{background:var(--amber);color:#141B20}\\n.send .ic{width:16px;height:16px;stroke-width:2}\\n.send.is-disabled{opacity:.35;cursor:not-allowed}\\n.composer-hint{\\n  display:flex;align-items:center;gap:6px;flex-wrap:wrap;\\n  margin-top:7px;\\n  padding:0 3px;\\n  font-size:10.5px;color:var(--ink-3);\\n}\\n.composer-hint .spacer{flex:1}\\nkbd{\\n  display:inline-block;\\n  padding:1px 4px;\\n  border:1px solid var(--line);\\n  border-bottom-width:2px;\\n  border-radius:3px;\\n  background:var(--surface);\\n  font-family:var(--font-mono);\\n  font-size:9.5px;\\n  color:var(--ink-2);\\n  line-height:1.4;\\n}\\n\\n/* ============================================================\\n   TRACE PANEL\\n   ============================================================ */\\n.trace{\\n  display:flex;flex-direction:column;min-height:0;\\n  background:var(--surface);\\n  border-left:1px solid var(--line);\\n  transition:opacity .18s;\\n}\\n.trace-head{\\n  flex:none;\\n  display:flex;align-items:center;justify-content:space-between;\\n  min-height:68px;\\n  padding:0 18px;\\n  border-bottom:1px solid var(--line);\\n}\\n.trace-title{display:flex;align-items:baseline;gap:7px}\\n.trace-title h2{font-size:13px;font-weight:650;letter-spacing:-.005em}\\n.trace-title span{font-size:10.5px;color:var(--ink-3)}\\n.trace-scroll{flex:1;overflow-y:auto;min-height:0;padding:16px 18px 24px}\\n\\n.run-line{display:flex;align-items:center;gap:8px;font-size:12px}\\n.run-line strong{font-weight:600;color:var(--ink)}\\n.run-line .mono{margin-left:auto;font-size:10px;color:var(--ink-3)}\\n.run-line .dot{width:6px;height:6px}\\n\\n.metrics{\\n  display:grid;grid-template-columns:1fr 1fr;\\n  gap:0 16px;\\n  margin-top:12px;\\n  border-top:1px solid var(--line-2);\\n}\\n.metric{padding:10px 0 9px;border-bottom:1px solid var(--line-2)}\\n.metric dt{font-size:10.5px;color:var(--ink-3)}\\n.metric dd{margin-top:2px;font-family:var(--font-mono);font-size:13px;font-weight:500;color:var(--ink)}\\n.metric dd small{font-family:var(--font-sans);font-size:10px;font-weight:400;color:var(--ink-3);margin-left:2px}\\n\\n.trace-section{margin-top:22px}\\n.trace-section-head{\\n  display:flex;align-items:center;gap:6px;\\n  margin-bottom:10px;\\n}\\n.trace-section-head h3{font-size:11.5px;font-weight:600;color:var(--ink-2);letter-spacing:.01em}\\n.trace-section-head .count{\\n  display:inline-grid;place-items:center;\\n  min-width:16px;height:16px;padding:0 4px;\\n  border-radius:3px;\\n  background:var(--surface-2);\\n  font-family:var(--font-mono);font-size:9.5px;color:var(--ink-3);\\n}\\n.trace-section-head .spacer{flex:1}\\n\\n/* execution track */\\n.track{position:relative;padding-left:22px}\\n.track::before{\\n  content:\\\"\\\";position:absolute;left:6px;top:6px;bottom:10px;\\n  width:1px;background:var(--line-2);\\n}\\n.track li{position:relative;padding-bottom:14px}\\n.track li:last-child{padding-bottom:0}\\n.track .marker{\\n  position:absolute;left:-22px;top:1px;\\n  display:grid;place-items:center;\\n  width:13px;height:13px;\\n  border-radius:50%;\\n  background:var(--surface);\\n  border:1px solid var(--line);\\n}\\n.track .marker .ic{width:9px;height:9px;stroke-width:2.4;color:var(--green)}\\n.track .is-now .marker{border-color:var(--amber);background:var(--amber-soft)}\\n.track .is-now .marker::after{content:\\\"\\\";width:4px;height:4px;border-radius:50%;background:var(--amber);animation:pulse 2.4s ease-in-out infinite}\\n.track .is-wait .marker{border-style:dashed}\\n.track .is-wait .marker::after{content:\\\"\\\";width:3px;height:1px;background:var(--ink-3)}\\n.track .label{display:flex;align-items:baseline;gap:7px;font-size:12px;color:var(--ink-2)}\\n.track .is-now .label{color:var(--ink);font-weight:550}\\n.track .label .mono{font-size:9.5px;color:var(--ink-3);margin-left:auto;font-weight:400}\\n.track .sub{margin-top:2px;font-family:var(--font-mono);font-size:9.5px;color:var(--ink-3)}\\n\\n/* citations */\\n.cite-list li{\\n  padding:9px 0;\\n  border-bottom:1px solid var(--line-2);\\n}\\n.cite-list li:last-child{border-bottom:0}\\n.cite-top{display:flex;align-items:baseline;gap:8px}\\n.cite-name{flex:1;min-width:0;font-size:12px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\\n.cite-score{font-family:var(--font-mono);font-size:10px;color:var(--prussian)}\\n.cite-src{margin-top:2px;font-size:10px;color:var(--ink-3)}\\n\\n/* agents */\\n.agent-row{display:flex;align-items:center;gap:9px;padding:8px 0;border-bottom:1px solid var(--line-2)}\\n.agent-row:last-child{border-bottom:0}\\n.agent-ident{flex:1;min-width:0}\\n.agent-name{font-size:12px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\\n.agent-name .mono{font-size:9.5px;color:var(--ink-3)}\\n.agent-kind{margin-top:1px;font-size:10px;color:var(--ink-3)}\\n.agent-state{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;color:var(--ink-2);white-space:nowrap}\\n.agent-state .dot{width:5px;height:5px}\\n\\n.trace-foot{\\n  margin-top:18px;padding-top:12px;\\n  border-top:1px solid var(--line-2);\\n}\\n.text-link{\\n  display:inline-flex;align-items:center;gap:5px;\\n  font-size:11px;color:var(--ink-2);\\n}\\n.text-link:hover{color:var(--ink);text-decoration:underline;text-underline-offset:3px}\\n.text-link .ic{width:12px;height:12px}\\n\\n/* ---------- toast ---------- */\\n.toast{\\n  position:fixed;\\n  left:50%;bottom:28px;\\n  z-index:100;\\n  transform:translate(-50%,10px);\\n  display:flex;align-items:center;gap:8px;\\n  max-width:min(420px, calc(100vw - 32px));\\n  padding:9px 13px;\\n  border-radius:6px;\\n  background:var(--ink);\\n  color:var(--paper);\\n  font-size:12px;\\n  box-shadow:0 8px 24px -8px rgba(0,0,0,.4);\\n  opacity:0;pointer-events:none;\\n  transition:opacity .18s, transform .18s;\\n}\\nhtml[data-theme=\\\"dark\\\"] .toast{background:var(--surface);border:1px solid var(--line)}\\n.toast.is-visible{opacity:1;transform:translate(-50%,0)}\\n.toast .ic{width:14px;height:14px;color:var(--green)}\\n\\n@keyframes pulse{\\n  0%,100%{opacity:1}\\n  50%{opacity:.4}\\n}\\n\\n/* ---------- responsive ---------- */\\n@media (max-width:1280px){\\n  :root{--sessions-w:264px;--trace-w:304px}\\n  .stream-inner{padding:26px 28px 14px}\\n  .composer-wrap{padding:8px 24px 12px}\\n  .chat-head{padding:0 24px}\\n}\\n\\n@media (max-width:1180px){\\n  .app{grid-template-columns:var(--nav-w) var(--sessions-w) minmax(0,1fr)}\\n  .trace{\\n    position:fixed;right:0;top:0;bottom:0;\\n    z-index:60;\\n    width:var(--trace-w);\\n    box-shadow:-24px 0 48px -32px rgba(0,0,0,.4);\\n    transform:translateX(101%);\\n    transition:transform .22s ease;\\n  }\\n  .app.trace-open .trace{transform:translateX(0)}\\n  .app.trace-collapsed{grid-template-columns:var(--nav-w) var(--sessions-w) minmax(0,1fr)}\\n  .app.trace-collapsed .trace{opacity:1;pointer-events:auto}\\n}\\n\\n@media (max-width:900px){\\n  .app{grid-template-columns:var(--nav-w) minmax(0,1fr)}\\n  .sessions{display:none}\\n  .stream-inner{padding:22px 20px 12px}\\n  .composer-wrap{padding:8px 16px 12px}\\n  .chat-head{padding:0 16px}\\n}\\n\\n@media (max-width:760px){\\n  .app{grid-template-columns:1fr;height:100dvh}\\n  .rail{\\n    position:fixed;left:0;right:0;bottom:0;\\n    flex-direction:row;\\n    width:auto;height:58px;\\n    padding:0 6px;\\n    border-top:1px solid var(--rail-line);\\n    z-index:70;\\n  }\\n  .brand,.rail-foot{display:none}\\n  .rail-nav{\\n    flex-direction:row;justify-content:space-around;align-items:stretch;\\n    margin:0;width:100%;gap:0;\\n  }\\n  .rail-item{width:auto;flex:1;justify-content:center;padding:6px 0 5px;gap:3px;border-radius:0}\\n  .rail-item .ic{width:19px;height:19px}\\n  .rail-item.is-active{background:transparent;color:var(--amber)}\\n  .rail-item.is-active::before{left:50%;top:0;bottom:auto;transform:translateX(-50%);width:20px;height:2px}\\n  .chat{padding-bottom:58px}\\n  .chat-head{min-height:60px}\\n  .chat-sub .sep,.chat-sub .mono{display:none}\\n  .status-chip{display:none}\\n  .stream-inner{padding:18px 14px 10px}\\n  .entry{padding-left:38px}\\n  .thread::before{left:15px}\\n  .node{left:11.5px}\\n  .thread-foot{margin-left:38px}\\n  .composer-wrap{padding:6px 10px 10px}\\n  .composer-hint{display:none}\\n  .trace{width:min(340px,88vw)}\\n  .tool-args{display:none}\\n  .data-table{font-size:12px}\\n  .prose h3{font-size:17px}\\n}\\n\\n@media (prefers-reduced-motion:reduce){\\n  *,*::before,*::after{animation-duration:.001ms !important;animation-iteration-count:1 !important;transition-duration:.001ms !important}\\n}\\n</style>\\n</head>\\n<body>\\n\\n<!-- inline icon sprite -->\\n<svg width=\\\"0\\\" height=\\\"0\\\" style=\\\"position:absolute\\\" aria-hidden=\\\"true\\\" focusable=\\\"false\\\">\\n  <defs>\\n    <symbol id=\\\"i-chat\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v8a2.5 2.5 0 0 1-2.5 2.5H9l-5 3.5V6.5Z\\\"/></symbol>\\n    <symbol id=\\\"i-stack\\\" viewBox=\\\"0 0 24 24\\\"><rect x=\\\"9\\\" y=\\\"4\\\" width=\\\"11\\\" height=\\\"11\\\" rx=\\\"1.5\\\"/><path d=\\\"M15 15v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h3\\\"/></symbol>\\n    <symbol id=\\\"i-bot\\\" viewBox=\\\"0 0 24 24\\\"><rect x=\\\"4\\\" y=\\\"7\\\" width=\\\"16\\\" height=\\\"12\\\" rx=\\\"3\\\"/><path d=\\\"M12 3v4M8 12h.01M16 12h.01M9 16h6\\\"/></symbol>\\n    <symbol id=\\\"i-flow\\\" viewBox=\\\"0 0 24 24\\\"><rect x=\\\"3.5\\\" y=\\\"3.5\\\" width=\\\"7\\\" height=\\\"7\\\" rx=\\\"1.5\\\"/><rect x=\\\"13.5\\\" y=\\\"13.5\\\" width=\\\"7\\\" height=\\\"7\\\" rx=\\\"1.5\\\"/><path d=\\\"M10.5 7h3a3 3 0 0 1 3 3v3.5\\\"/></symbol>\\n    <symbol id=\\\"i-db\\\" viewBox=\\\"0 0 24 24\\\"><ellipse cx=\\\"12\\\" cy=\\\"6\\\" rx=\\\"7\\\" ry=\\\"3\\\"/><path d=\\\"M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6\\\"/></symbol>\\n    <symbol id=\\\"i-sliders\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M4 7h9M18 7h2M4 17h3M12 17h8\\\"/><circle cx=\\\"15.5\\\" cy=\\\"7\\\" r=\\\"2\\\"/><circle cx=\\\"9.5\\\" cy=\\\"17\\\" r=\\\"2\\\"/></symbol>\\n    <symbol id=\\\"i-search\\\" viewBox=\\\"0 0 24 24\\\"><circle cx=\\\"11\\\" cy=\\\"11\\\" r=\\\"6\\\"/><path d=\\\"M16 16l4 4\\\"/></symbol>\\n    <symbol id=\\\"i-plus\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M12 5v14M5 12h14\\\"/></symbol>\\n    <symbol id=\\\"i-chevron\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M6 9l6 6 6-6\\\"/></symbol>\\n    <symbol id=\\\"i-panel\\\" viewBox=\\\"0 0 24 24\\\"><rect x=\\\"3.5\\\" y=\\\"4.5\\\" width=\\\"17\\\" height=\\\"15\\\" rx=\\\"2\\\"/><path d=\\\"M15 4.5v15\\\"/></symbol>\\n    <symbol id=\\\"i-sun\\\" viewBox=\\\"0 0 24 24\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"4\\\"/><path d=\\\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\\\"/></symbol>\\n    <symbol id=\\\"i-moon\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M20 14.5A8 8 0 0 1 9.5 4 7 7 0 1 0 20 14.5Z\\\"/></symbol>\\n    <symbol id=\\\"i-clip\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M20 11.5l-7.8 7.8a5 5 0 0 1-7-7l8.5-8.5a3.3 3.3 0 0 1 4.7 4.7l-8.5 8.5a1.7 1.7 0 0 1-2.4-2.4l7.8-7.8\\\"/></symbol>\\n    <symbol id=\\\"i-at\\\" viewBox=\\\"0 0 24 24\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"4\\\"/><path d=\\\"M16 12v1.5a2.5 2.5 0 0 0 5 0V12a9 9 0 1 0-3.6 7.1\\\"/></symbol>\\n    <symbol id=\\\"i-up\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M12 19V5M6 11l6-6 6 6\\\"/></symbol>\\n    <symbol id=\\\"i-check\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M5 12l5 5L19 7\\\"/></symbol>\\n    <symbol id=\\\"i-x\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M6 6l12 12M18 6L6 18\\\"/></symbol>\\n    <symbol id=\\\"i-clock\\\" viewBox=\\\"0 0 24 24\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"8\\\"/><path d=\\\"M12 8v4l3 2\\\"/></symbol>\\n    <symbol id=\\\"i-copy\\\" viewBox=\\\"0 0 24 24\\\"><rect x=\\\"9\\\" y=\\\"9\\\" width=\\\"11\\\" height=\\\"11\\\" rx=\\\"2\\\"/><path d=\\\"M5 15V6a2 2 0 0 1 2-2h9\\\"/></symbol>\\n    <symbol id=\\\"i-shield\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M12 3l7 3v6c0 4.4-3 7.5-7 9-4-1.5-7-4.6-7-9V6l7-3Z\\\"/></symbol>\\n    <symbol id=\\\"i-stop\\\" viewBox=\\\"0 0 24 24\\\"><rect x=\\\"7\\\" y=\\\"7\\\" width=\\\"10\\\" height=\\\"10\\\" rx=\\\"1.5\\\"/></symbol>\\n    <symbol id=\\\"i-arrow\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M5 12h14M13 6l6 6-6 6\\\"/></symbol>\\n    <symbol id=\\\"i-external\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5\\\"/></symbol>\\n    <symbol id=\\\"i-archive\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M4 8h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V8Z\\\"/><path d=\\\"M3 4h18v4H3zM10 12h4\\\"/></symbol>\\n  </defs>\\n</svg>\\n\\n<div class=\\\"app\\\" id=\\\"app\\\">\\n\\n  <!-- ================= RAIL ================= -->\\n  <nav class=\\\"rail\\\" aria-label=\\\"主导航\\\">\\n    <a class=\\\"brand\\\" href=\\\"#\\\" aria-label=\\\"Agent Hub 首页\\\">\\n      <svg class=\\\"brand-mark\\\" viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\">\\n        <path d=\\\"M4.5 6.5h5.2a3.8 3.8 0 0 1 3.8 3.8v3.4a3.8 3.8 0 0 0 3.8 3.8h2.2\\\"/>\\n        <circle cx=\\\"4.5\\\" cy=\\\"6.5\\\" r=\\\"1.9\\\"/>\\n        <circle class=\\\"hot\\\" cx=\\\"19.5\\\" cy=\\\"17.5\\\" r=\\\"2\\\"/>\\n      </svg>\\n    </a>\\n\\n    <div class=\\\"rail-nav\\\">\\n      <button class=\\\"rail-item is-active\\\" aria-current=\\\"page\\\" title=\\\"对话\\\">\\n        <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-chat\\\"/></svg>\\n        <span>对话</span>\\n      </button>\\n      <button class=\\\"rail-item\\\" title=\\\"会话\\\">\\n        <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-stack\\\"/></svg>\\n        <span>会话</span>\\n      </button>\\n      <button class=\\\"rail-item\\\" title=\\\"智能体\\\">\\n        <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-bot\\\"/></svg>\\n        <span>智能体</span>\\n      </button>\\n      <button class=\\\"rail-item\\\" title=\\\"任务\\\">\\n        <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-flow\\\"/></svg>\\n        <span>任务</span>\\n      </button>\\n      <button class=\\\"rail-item\\\" title=\\\"知识库\\\">\\n        <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-db\\\"/></svg>\\n        <span>知识库</span>\\n      </button>\\n      <button class=\\\"rail-item\\\" title=\\\"设置\\\">\\n        <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-sliders\\\"/></svg>\\n        <span>设置</span>\\n      </button>\\n    </div>\\n\\n    <div class=\\\"rail-foot\\\">\\n      <button class=\\\"rail-icon\\\" id=\\\"themeToggle\\\" aria-label=\\\"切换深浅主题\\\" title=\\\"切换主题\\\">\\n        <svg class=\\\"ic ic-moon\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-moon\\\"/></svg>\\n        <svg class=\\\"ic ic-sun\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-sun\\\"/></svg>\\n      </button>\\n      <button class=\\\"avatar\\\" title=\\\"账号\\\">AH</button>\\n      <span class=\\\"rail-version\\\">v0.1</span>\\n    </div>\\n  </nav>\\n\\n  <!-- ================= SESSIONS ================= -->\\n  <aside class=\\\"sessions\\\" aria-label=\\\"会话列表\\\">\\n    <div class=\\\"sessions-head\\\">\\n      <h1 class=\\\"sessions-title\\\">会话</h1>\\n      <button class=\\\"btn-new\\\" id=\\\"newSession\\\">\\n        <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-plus\\\"/></svg>\\n        新建\\n      </button>\\n    </div>\\n\\n    <label class=\\\"search\\\">\\n      <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-search\\\"/></svg>\\n      <input id=\\\"sessionSearch\\\" type=\\\"search\\\" placeholder=\\\"搜索会话\\\" autocomplete=\\\"off\\\" aria-label=\\\"搜索会话\\\" />\\n    </label>\\n\\n    <div class=\\\"session-scroll\\\" id=\\\"sessionScroll\\\">\\n      <div class=\\\"session-group\\\">\\n        <div class=\\\"group-label\\\">今天</div>\\n        <button class=\\\"session is-active\\\" aria-current=\\\"page\\\">\\n          <span class=\\\"session-title\\\">Q3 客服工单周报</span>\\n          <span class=\\\"session-meta\\\">\\n            <span class=\\\"dot is-live\\\"></span>运行中<span class=\\\"sep\\\">·</span>2 分钟前\\n          </span>\\n        </button>\\n        <button class=\\\"session\\\">\\n          <span class=\\\"session-title\\\">退款政策变更的影响面</span>\\n          <span class=\\\"session-meta\\\">14:20<span class=\\\"sep\\\">·</span>37 条消息</span>\\n        </button>\\n        <button class=\\\"session\\\">\\n          <span class=\\\"session-title\\\">把 release notes 翻成英文</span>\\n          <span class=\\\"session-meta\\\">11:05<span class=\\\"sep\\\">·</span>12 条消息</span>\\n        </button>\\n      </div>\\n\\n      <div class=\\\"session-group\\\">\\n        <div class=\\\"group-label\\\">昨天</div>\\n        <button class=\\\"session\\\">\\n          <span class=\\\"session-title\\\">审查：payment 模块重试逻辑</span>\\n          <span class=\\\"session-meta\\\">18:42<span class=\\\"sep\\\">·</span>64 条消息</span>\\n        </button>\\n        <button class=\\\"session\\\">\\n          <span class=\\\"session-title\\\">知识库检索质量排查</span>\\n          <span class=\\\"session-meta\\\">09:31<span class=\\\"sep\\\">·</span>21 条消息</span>\\n        </button>\\n      </div>\\n\\n      <div class=\\\"session-group\\\">\\n        <div class=\\\"group-label\\\">10 月</div>\\n        <button class=\\\"session\\\">\\n          <span class=\\\"session-title\\\">客服话术改写 · 第二版</span>\\n          <span class=\\\"session-meta\\\"><span class=\\\"dot\\\"></span>已归档<span class=\\\"sep\\\">·</span>10 月 29 日</span>\\n        </button>\\n        <button class=\\\"session\\\">\\n          <span class=\\\"session-title\\\">A2A 智能体接入检查</span>\\n          <span class=\\\"session-meta\\\">10 月 26 日<span class=\\\"sep\\\">·</span>18 条消息</span>\\n        </button>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"sessions-foot\\\">\\n      <span class=\\\"conn\\\"><span class=\\\"dot is-ok\\\"></span>A2A 网关已连接</span>\\n      <span class=\\\"mono\\\">3 ONLINE</span>\\n    </div>\\n  </aside>\\n\\n  <!-- ================= CHAT ================= -->\\n  <main class=\\\"chat\\\">\\n    <header class=\\\"chat-head\\\">\\n      <div class=\\\"chat-heading\\\">\\n        <h2 class=\\\"chat-title\\\">Q3 客服工单周报</h2>\\n        <div class=\\\"chat-sub\\\">\\n          <span>main-agent</span>\\n          <span class=\\\"sep\\\">/</span>\\n          <span>知识库 12 段引用</span>\\n          <span class=\\\"sep\\\">/</span>\\n          <span class=\\\"mono\\\">run_8f3a2c</span>\\n        </div>\\n      </div>\\n      <div class=\\\"chat-actions\\\">\\n        <span class=\\\"status-chip is-live\\\"><span class=\\\"dot is-live\\\"></span>运行中</span>\\n        <button class=\\\"icon-btn\\\" id=\\\"traceToggle\\\" title=\\\"运行详情\\\" aria-label=\\\"切换运行详情面板\\\" aria-expanded=\\\"true\\\">\\n          <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-panel\\\"/></svg>\\n        </button>\\n        <button class=\\\"icon-btn\\\" title=\\\"更多操作\\\" aria-label=\\\"更多操作\\\">\\n          <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-sliders\\\"/></svg>\\n        </button>\\n      </div>\\n    </header>\\n\\n    <div class=\\\"stream\\\" id=\\\"stream\\\">\\n      <div class=\\\"stream-inner\\\">\\n        <ol class=\\\"thread\\\" id=\\\"thread\\\">\\n\\n          <!-- user -->\\n          <li class=\\\"entry entry-user\\\">\\n            <span class=\\\"node\\\" aria-hidden=\\\"true\\\"></span>\\n            <div class=\\\"entry-head\\\">\\n              <span class=\\\"who\\\">你</span>\\n              <span class=\\\"who-sub\\\">通过 Web 工作台</span>\\n              <span class=\\\"spacer\\\"></span>\\n              <time>22:41</time>\\n            </div>\\n            <div class=\\\"entry-body\\\">\\n              <p class=\\\"prompt-bubble\\\">把本季度 128 条客服工单按问题类型归类，写一份给团队看的周报。数字要能追溯来源，写完让编辑智能体过一遍措辞，先别发出去。</p>\\n              <div class=\\\"attachments\\\">\\n                <span class=\\\"attach\\\">\\n                  <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-clip\\\"/></svg>\\n                  q3-support-tickets.csv\\n                  <span class=\\\"mono\\\">128 行 · 24 KB</span>\\n                </span>\\n              </div>\\n            </div>\\n          </li>\\n\\n          <!-- assistant intro -->\\n          <li class=\\\"entry entry-assistant\\\">\\n            <span class=\\\"node\\\" aria-hidden=\\\"true\\\"></span>\\n            <div class=\\\"entry-head\\\">\\n              <span class=\\\"who\\\">main-agent</span>\\n              <span class=\\\"who-sub\\\">调度员</span>\\n              <span class=\\\"spacer\\\"></span>\\n              <button class=\\\"copy-btn\\\" data-copy=\\\"我先对齐知识库里的分类口径，再对工单做聚合；周报草稿会引用具体来源，最后交给 editorial-reviewer 审阅措辞。\\\">\\n                <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-copy\\\"/></svg>复制\\n              </button>\\n              <time>22:41</time>\\n            </div>\\n            <div class=\\\"entry-body prose\\\">\\n              <p>我先对齐知识库里的分类口径，再对工单做聚合；周报草稿会引用具体来源，最后交给 editorial-reviewer 审阅措辞。</p>\\n            </div>\\n          </li>\\n\\n          <!-- tool: knowledge.search (open) -->\\n          <li class=\\\"entry entry-tool\\\">\\n            <span class=\\\"node\\\" aria-hidden=\\\"true\\\"></span>\\n            <div class=\\\"entry-body\\\">\\n              <details class=\\\"tool-card\\\" open>\\n                <summary>\\n                  <span class=\\\"tool-name\\\">knowledge.search</span>\\n                  <span class=\\\"tool-args\\\">\\\"退款口径 · 工单分类\\\"</span>\\n                  <span class=\\\"tool-result\\\"><svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-check\\\"/></svg>完成</span>\\n                  <span class=\\\"tool-time\\\">0.8s</span>\\n                  <svg class=\\\"ic chev\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-chevron\\\"/></svg>\\n                </summary>\\n                <div class=\\\"tool-body\\\">\\n                  <div class=\\\"hit\\\">\\n                    <span class=\\\"hit-title\\\">工单分类规范 v3</span>\\n                    <span class=\\\"hit-score\\\">0.92</span>\\n                    <span class=\\\"hit-date\\\">09-18</span>\\n                  </div>\\n                  <div class=\\\"hit\\\">\\n                    <span class=\\\"hit-title\\\">退款处理 SOP</span>\\n                    <span class=\\\"hit-score\\\">0.87</span>\\n                    <span class=\\\"hit-date\\\">08-02</span>\\n                  </div>\\n                  <div class=\\\"hit\\\">\\n                    <span class=\\\"hit-title\\\">售后话术库 · 分类索引</span>\\n                    <span class=\\\"hit-score\\\">0.81</span>\\n                    <span class=\\\"hit-date\\\">07-21</span>\\n                  </div>\\n                  <div class=\\\"tool-note\\\">top_k=3 · collection support-kb · 12.4k tokens</div>\\n                </div>\\n              </details>\\n            </div>\\n          </li>\\n\\n          <!-- tool: aggregate (closed) -->\\n          <li class=\\\"entry entry-tool\\\">\\n            <span class=\\\"node\\\" aria-hidden=\\\"true\\\"></span>\\n            <div class=\\\"entry-body\\\">\\n              <details class=\\\"tool-card\\\">\\n                <summary>\\n                  <span class=\\\"tool-name\\\">tickets.aggregate</span>\\n                  <span class=\\\"tool-args\\\">issue_type · 128 rows</span>\\n                  <span class=\\\"tool-result\\\"><svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-check\\\"/></svg>完成</span>\\n                  <span class=\\\"tool-time\\\">1.4s</span>\\n                  <svg class=\\\"ic chev\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-chevron\\\"/></svg>\\n                </summary>\\n                <div class=\\\"tool-body\\\">\\n                  <div class=\\\"hit\\\"><span class=\\\"hit-title\\\">reads: q3-support-tickets.csv</span><span class=\\\"hit-score\\\">128 / 128</span></div>\\n                  <div class=\\\"hit\\\"><span class=\\\"hit-title\\\">group_by: issue_type</span><span class=\\\"hit-score\\\">5 groups</span></div>\\n                  <div class=\\\"tool-note\\\">sandbox · read-only · 1.4s</div>\\n                </div>\\n              </details>\\n            </div>\\n          </li>\\n\\n          <!-- assistant report -->\\n          <li class=\\\"entry entry-assistant\\\">\\n            <span class=\\\"node\\\" aria-hidden=\\\"true\\\"></span>\\n            <div class=\\\"entry-head\\\">\\n              <span class=\\\"who\\\">main-agent</span>\\n              <span class=\\\"who-sub\\\">周报草稿</span>\\n              <span class=\\\"spacer\\\"></span>\\n              <button class=\\\"copy-btn\\\" data-copy=\\\"Q3 客服工单周报\\\">\\n                <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-copy\\\"/></svg>复制\\n              </button>\\n              <time>22:43</time>\\n            </div>\\n            <div class=\\\"entry-body prose\\\">\\n              <h3>Q3 客服工单周报</h3>\\n              <p>本季度共收到 <strong>128 条</strong>工单，比上季度减少 6%。退款与退货仍是最集中的问题类型，但平均处理时长从 31 小时降到 24 小时。<span class=\\\"cite\\\">1</span></p>\\n\\n              <table class=\\\"data-table\\\">\\n                <caption>按主标签归类，环比相对 Q2</caption>\\n                <thead>\\n                  <tr>\\n                    <th scope=\\\"col\\\">问题类型</th>\\n                    <th scope=\\\"col\\\" class=\\\"num\\\">数量</th>\\n                    <th scope=\\\"col\\\" class=\\\"num\\\">占比</th>\\n                    <th scope=\\\"col\\\" class=\\\"num\\\">环比</th>\\n                  </tr>\\n                </thead>\\n                <tbody>\\n                  <tr><td>退款与退货</td><td class=\\\"num\\\">46</td><td class=\\\"num\\\">35.9%</td><td class=\\\"num delta-up\\\">+8</td></tr>\\n                  <tr><td>物流异常</td><td class=\\\"num\\\">31</td><td class=\\\"num\\\">24.2%</td><td class=\\\"num delta-down\\\">−12</td></tr>\\n                  <tr><td>商品质量</td><td class=\\\"num\\\">24</td><td class=\\\"num\\\">18.8%</td><td class=\\\"num delta-down\\\">−3</td></tr>\\n                  <tr><td>账号与支付</td><td class=\\\"num\\\">17</td><td class=\\\"num\\\">13.3%</td><td class=\\\"num delta-up\\\">+2</td></tr>\\n                  <tr><td>其他</td><td class=\\\"num\\\">10</td><td class=\\\"num\\\">7.8%</td><td class=\\\"num delta-down\\\">−1</td></tr>\\n                </tbody>\\n              </table>\\n\\n              <h4>需要团队注意的三处变化</h4>\\n              <ul>\\n                <li>退款高峰集中在 8 月第二周，与 7 月底促销的退单延后有关。<span class=\\\"cite\\\">1</span></li>\\n                <li>物流异常减少 12 条，主要因为新承运商在华东区上线。</li>\\n                <li>账号与支付类工单里有 6 条指向同一支付渠道的重复扣款，建议单独立案跟进。<span class=\\\"cite\\\">2</span></li>\\n              </ul>\\n\\n              <blockquote>口径说明：分类依据《工单分类规范 v3》，多标签工单按主标签计入；“其他”包含 4 条未分类的测试工单。<span class=\\\"cite\\\">2</span></blockquote>\\n            </div>\\n          </li>\\n\\n          <!-- A2A task -->\\n          <li class=\\\"entry entry-a2a\\\">\\n            <span class=\\\"node\\\" aria-hidden=\\\"true\\\"></span>\\n            <div class=\\\"entry-body\\\">\\n              <div class=\\\"a2a-card\\\">\\n                <div class=\\\"a2a-top\\\">\\n                  <span class=\\\"agent-badge\\\" aria-hidden=\\\"true\\\">ER</span>\\n                  <div class=\\\"a2a-ident\\\">\\n                    <div class=\\\"a2a-name\\\">\\n                      editorial-reviewer\\n                      <span class=\\\"tag\\\">A2A 1.0</span>\\n                    </div>\\n                    <div class=\\\"a2a-task\\\">审阅周报措辞，标注生硬或过度承诺的表达</div>\\n                  </div>\\n                  <span class=\\\"a2a-status\\\"><span class=\\\"dot is-live\\\"></span>运行中</span>\\n                </div>\\n                <div class=\\\"progress\\\" role=\\\"progressbar\\\" aria-valuemin=\\\"0\\\" aria-valuemax=\\\"5\\\" aria-valuenow=\\\"3\\\" aria-label=\\\"任务进度 3 / 5\\\">\\n                  <span style=\\\"width:62%\\\"></span>\\n                </div>\\n                <div class=\\\"steps\\\">\\n                  <span class=\\\"step is-done\\\"><svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-check\\\"/></svg>读取草稿</span>\\n                  <svg class=\\\"ic arrow\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-arrow\\\"/></svg>\\n                  <span class=\\\"step is-done\\\"><svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-check\\\"/></svg>语气一致性</span>\\n                  <svg class=\\\"ic arrow\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-arrow\\\"/></svg>\\n                  <span class=\\\"step is-done\\\"><svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-check\\\"/></svg>数字核对</span>\\n                  <svg class=\\\"ic arrow\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-arrow\\\"/></svg>\\n                  <span class=\\\"step is-now\\\"><span class=\\\"dot\\\"></span>术语替换 · 进行中</span>\\n                  <svg class=\\\"ic arrow\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-arrow\\\"/></svg>\\n                  <span class=\\\"step\\\">返回修改建议</span>\\n                </div>\\n                <div class=\\\"a2a-foot\\\">\\n                  <span>task_7c1e</span>\\n                  <span>·</span>\\n                  <span>已运行 00:18</span>\\n                  <span class=\\\"spacer\\\"></span>\\n                  <button class=\\\"btn-ghost\\\" data-cancel-task>取消任务</button>\\n                </div>\\n              </div>\\n            </div>\\n          </li>\\n\\n          <!-- approval -->\\n          <li class=\\\"entry entry-approval\\\" id=\\\"approvalEntry\\\">\\n            <span class=\\\"node\\\" aria-hidden=\\\"true\\\"></span>\\n            <div class=\\\"entry-head\\\">\\n              <span class=\\\"who\\\">审批</span>\\n              <span class=\\\"who-sub\\\">发送前确认</span>\\n              <span class=\\\"spacer\\\"></span>\\n              <time>22:43</time>\\n            </div>\\n            <div class=\\\"entry-body\\\">\\n              <div class=\\\"approval-card\\\" id=\\\"approvalCard\\\">\\n                <div class=\\\"approval-head\\\">\\n                  <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-shield\\\"/></svg>\\n                  <span class=\\\"approval-title\\\">需要你的决定</span>\\n                  <span class=\\\"status-chip is-warn\\\" id=\\\"approvalStatus\\\">待审批</span>\\n                </div>\\n                <div class=\\\"approval-body\\\">\\n                  <p class=\\\"approval-action\\\">将周报发布到 <b>#support-weekly</b>，并 @ 值班同事。</p>\\n                  <dl class=\\\"risk-list\\\">\\n                    <dt>可见范围</dt><dd>频道内 12 名成员</dd>\\n                    <dt>可撤回</dt><dd>发布后 24 小时内</dd>\\n                    <dt>发起方</dt><dd>main-agent · run_8f3a2c</dd>\\n                  </dl>\\n                </div>\\n                <div class=\\\"approval-actions\\\">\\n                  <span class=\\\"spacer\\\"></span>\\n                  <button class=\\\"btn btn-outline\\\" data-decision=\\\"reject\\\">拒绝</button>\\n                  <button class=\\\"btn btn-primary\\\" data-decision=\\\"approve\\\">批准并发送</button>\\n                </div>\\n                <div class=\\\"resolved-note\\\">\\n                  <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-check\\\"/></svg>\\n                  <span id=\\\"resolvedText\\\">已批准，消息已发送到 #support-weekly。</span>\\n                </div>\\n              </div>\\n            </div>\\n          </li>\\n\\n        </ol>\\n\\n        <div class=\\\"thread-foot\\\">\\n          <span>本轮由 main-agent 调度</span>\\n          <span>·</span>\\n          <span class=\\\"mono\\\">2 remote agents</span>\\n        </div>\\n      </div>\\n    </div>\\n\\n    <!-- composer -->\\n    <div class=\\\"composer-wrap\\\">\\n      <div class=\\\"composer-inner\\\">\\n        <div class=\\\"composer\\\">\\n          <textarea id=\\\"composerInput\\\" rows=\\\"1\\\" placeholder=\\\"继续调度…（Enter 发送，Shift+Enter 换行）\\\" aria-label=\\\"输入消息\\\"></textarea>\\n          <div class=\\\"composer-bar\\\">\\n            <button class=\\\"composer-tool\\\" title=\\\"添加附件\\\">\\n              <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-clip\\\"/></svg>\\n              附件\\n            </button>\\n            <button class=\\\"composer-tool\\\" title=\\\"提及智能体\\\">\\n              <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-at\\\"/></svg>\\n              智能体\\n            </button>\\n            <span class=\\\"model-chip\\\"><span class=\\\"dot\\\"></span>deepseek-chat · T 0.3</span>\\n            <span class=\\\"spacer\\\"></span>\\n            <button class=\\\"send\\\" id=\\\"sendBtn\\\" aria-label=\\\"发送消息\\\">\\n              <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-up\\\"/></svg>\\n            </button>\\n          </div>\\n        </div>\\n        <div class=\\\"composer-hint\\\">\\n          <span><kbd>Enter</kbd> 发送</span>\\n          <span>·</span>\\n          <span><kbd>Shift</kbd> + <kbd>Enter</kbd> 换行</span>\\n          <span class=\\\"spacer\\\"></span>\\n          <span>模型输出可能有误，请核对关键数字</span>\\n        </div>\\n      </div>\\n    </div>\\n  </main>\\n\\n  <!-- ================= TRACE ================= -->\\n  <aside class=\\\"trace\\\" id=\\\"trace\\\" aria-label=\\\"本轮运行详情\\\">\\n    <div class=\\\"trace-head\\\">\\n      <div class=\\\"trace-title\\\">\\n        <h2>本轮运行</h2>\\n        <span>run_8f3a2c</span>\\n      </div>\\n      <button class=\\\"icon-btn\\\" id=\\\"traceClose\\\" title=\\\"收起面板\\\" aria-label=\\\"收起运行详情\\\">\\n        <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-x\\\"/></svg>\\n      </button>\\n    </div>\\n\\n    <div class=\\\"trace-scroll\\\">\\n      <div class=\\\"run-line\\\">\\n        <span class=\\\"dot is-live\\\"></span>\\n        <strong>进行中</strong>\\n        <span class=\\\"mono\\\">已用 00:42</span>\\n      </div>\\n\\n      <dl class=\\\"metrics\\\">\\n        <div class=\\\"metric\\\"><dt>输入 tokens</dt><dd>12.4k</dd></div>\\n        <div class=\\\"metric\\\"><dt>输出 tokens</dt><dd>1.8k</dd></div>\\n        <div class=\\\"metric\\\"><dt>模型</dt><dd style=\\\"font-size:11.5px\\\">deepseek-chat</dd></div>\\n        <div class=\\\"metric\\\"><dt>温度</dt><dd>0.3</dd></div>\\n      </dl>\\n\\n      <section class=\\\"trace-section\\\">\\n        <div class=\\\"trace-section-head\\\">\\n          <h3>执行轨道</h3>\\n          <span class=\\\"spacer\\\"></span>\\n          <span class=\\\"count\\\">5</span>\\n        </div>\\n        <ol class=\\\"track\\\">\\n          <li class=\\\"is-done\\\">\\n            <span class=\\\"marker\\\"><svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-check\\\"/></svg></span>\\n            <div class=\\\"label\\\">理解任务<span class=\\\"mono\\\">0.2s</span></div>\\n            <div class=\\\"sub\\\">main-agent</div>\\n          </li>\\n          <li class=\\\"is-done\\\">\\n            <span class=\\\"marker\\\"><svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-check\\\"/></svg></span>\\n            <div class=\\\"label\\\">knowledge.search<span class=\\\"mono\\\">0.8s</span></div>\\n            <div class=\\\"sub\\\">3 hits · support-kb</div>\\n          </li>\\n          <li class=\\\"is-done\\\">\\n            <span class=\\\"marker\\\"><svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-check\\\"/></svg></span>\\n            <div class=\\\"label\\\">tickets.aggregate<span class=\\\"mono\\\">1.4s</span></div>\\n            <div class=\\\"sub\\\">128 rows → 5 groups</div>\\n          </li>\\n          <li class=\\\"is-now\\\">\\n            <span class=\\\"marker\\\"></span>\\n            <div class=\\\"label\\\">editorial-reviewer<span class=\\\"mono\\\">00:18</span></div>\\n            <div class=\\\"sub\\\">A2A · task_7c1e · 3 / 5</div>\\n          </li>\\n          <li class=\\\"is-wait\\\">\\n            <span class=\\\"marker\\\"></span>\\n            <div class=\\\"label\\\">发送审批<span class=\\\"mono\\\">—</span></div>\\n            <div class=\\\"sub\\\">等待你的决定</div>\\n          </li>\\n        </ol>\\n      </section>\\n\\n      <section class=\\\"trace-section\\\">\\n        <div class=\\\"trace-section-head\\\">\\n          <h3>引用来源</h3>\\n          <span class=\\\"spacer\\\"></span>\\n          <span class=\\\"count\\\">3</span>\\n        </div>\\n        <ul class=\\\"cite-list\\\">\\n          <li>\\n            <div class=\\\"cite-top\\\"><span class=\\\"cite-name\\\">工单分类规范 v3</span><span class=\\\"cite-score\\\">0.92</span></div>\\n            <div class=\\\"cite-src\\\">support-kb · 09-18 · 知识库</div>\\n          </li>\\n          <li>\\n            <div class=\\\"cite-top\\\"><span class=\\\"cite-name\\\">退款处理 SOP</span><span class=\\\"cite-score\\\">0.87</span></div>\\n            <div class=\\\"cite-src\\\">support-kb · 08-02 · 知识库</div>\\n          </li>\\n          <li>\\n            <div class=\\\"cite-top\\\"><span class=\\\"cite-name\\\">售后话术库 · 分类索引</span><span class=\\\"cite-score\\\">0.81</span></div>\\n            <div class=\\\"cite-src\\\">support-kb · 07-21 · 知识库</div>\\n          </li>\\n        </ul>\\n      </section>\\n\\n      <section class=\\\"trace-section\\\">\\n        <div class=\\\"trace-section-head\\\">\\n          <h3>智能体</h3>\\n          <span class=\\\"spacer\\\"></span>\\n          <span class=\\\"count\\\">3</span>\\n        </div>\\n        <div class=\\\"agent-row\\\">\\n          <span class=\\\"agent-badge\\\" aria-hidden=\\\"true\\\">MA</span>\\n          <div class=\\\"agent-ident\\\">\\n            <div class=\\\"agent-name\\\">main-agent <span class=\\\"mono\\\">local</span></div>\\n            <div class=\\\"agent-kind\\\">调度 · deepseek-chat</div>\\n          </div>\\n          <span class=\\\"agent-state\\\"><span class=\\\"dot is-ok\\\"></span>在线</span>\\n        </div>\\n        <div class=\\\"agent-row\\\">\\n          <span class=\\\"agent-badge\\\" aria-hidden=\\\"true\\\">ER</span>\\n          <div class=\\\"agent-ident\\\">\\n            <div class=\\\"agent-name\\\">editorial-reviewer <span class=\\\"mono\\\">a2a</span></div>\\n            <div class=\\\"agent-kind\\\">copy-review · 运行中</div>\\n          </div>\\n          <span class=\\\"agent-state\\\"><span class=\\\"dot is-live\\\"></span>忙碌</span>\\n        </div>\\n        <div class=\\\"agent-row\\\">\\n          <span class=\\\"agent-badge\\\" aria-hidden=\\\"true\\\">DA</span>\\n          <div class=\\\"agent-ident\\\">\\n            <div class=\\\"agent-name\\\">data-analyst <span class=\\\"mono\\\">a2a</span></div>\\n            <div class=\\\"agent-kind\\\">sql · csv 分析</div>\\n          </div>\\n          <span class=\\\"agent-state\\\"><span class=\\\"dot is-ok\\\"></span>空闲</span>\\n        </div>\\n      </section>\\n\\n      <div class=\\\"trace-foot\\\">\\n        <button class=\\\"text-link\\\">\\n          查看完整运行日志\\n          <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-external\\\"/></svg>\\n        </button>\\n      </div>\\n    </div>\\n  </aside>\\n</div>\\n\\n<div class=\\\"toast\\\" id=\\\"toast\\\" role=\\\"status\\\" aria-live=\\\"polite\\\">\\n  <svg class=\\\"ic\\\" aria-hidden=\\\"true\\\"><use href=\\\"#i-check\\\"/></svg>\\n  <span id=\\\"toastText\\\"></span>\\n</div>\\n\\n<script>\\n(function () {\\n  'use strict';\\n\\n  var root = document.documentElement;\\n  var app = document.getElementById('app');\\n  var stream = document.getElementById('stream');\\n  var thread = document.getElementById('thread');\\n  var input = document.getElementById('composerInput');\\n  var sendBtn = document.getElementById('sendBtn');\\n  var toast = document.getElementById('toast');\\n  var toastText = document.getElementById('toastText');\\n  var approvalCard = document.getElementById('approvalCard');\\n  var approvalStatus = document.getElementById('approvalStatus');\\n  var resolvedText = document.getElementById('resolvedText');\\n  var traceToggle = document.getElementById('traceToggle');\\n  var traceClose = document.getElementById('traceClose');\\n  var approvalPending = true;\\n  var toastTimer = null;\\n\\n  /* ---------- theme ---------- */\\n  try {\\n    var savedTheme = localStorage.getItem('ah-theme');\\n    if (savedTheme === 'dark' || savedTheme === 'light') root.dataset.theme = savedTheme;\\n  } catch (e) { /* file:// storage may be unavailable */ }\\n\\n  document.getElementById('themeToggle').addEventListener('click', function () {\\n    var next = root.dataset.theme === 'dark' ? 'light' : 'dark';\\n    root.dataset.theme = next;\\n    try { localStorage.setItem('ah-theme', next); } catch (e) {}\\n    showToast(next === 'dark' ? '已切换到深色主题' : '已切换到浅色主题');\\n  });\\n\\n  /* ---------- toast ---------- */\\n  function showToast(text) {\\n    toastText.textContent = text;\\n    toast.classList.add('is-visible');\\n    clearTimeout(toastTimer);\\n    toastTimer = setTimeout(function () {\\n      toast.classList.remove('is-visible');\\n    }, 2400);\\n  }\\n\\n  /* ---------- trace panel ---------- */\\n  var wide = window.matchMedia('(min-width: 1181px)');\\n\\n  function setTraceExpanded(expanded) {\\n    traceToggle.setAttribute('aria-expanded', String(expanded));\\n  }\\n\\n  traceToggle.addEventListener('click', function () {\\n    if (wide.matches) {\\n      var collapsed = app.classList.toggle('trace-collapsed');\\n      setTraceExpanded(!collapsed);\\n    } else {\\n      var open = app.classList.toggle('trace-open');\\n      setTraceExpanded(open);\\n    }\\n  });\\n\\n  traceClose.addEventListener('click', function () {\\n    if (wide.matches) {\\n      app.classList.add('trace-collapsed');\\n      setTraceExpanded(false);\\n    } else {\\n      app.classList.remove('trace-open');\\n      setTraceExpanded(false);\\n    }\\n  });\\n\\n  wide.addEventListener('change', function () {\\n    app.classList.remove('trace-open');\\n    if (wide.matches) {\\n      app.classList.remove('trace-collapsed');\\n      setTraceExpanded(true);\\n    }\\n  });\\n\\n  /* ---------- session list ---------- */\\n  var sessions = Array.prototype.slice.call(document.querySelectorAll('.session'));\\n  sessions.forEach(function (item) {\\n    item.addEventListener('click', function () {\\n      sessions.forEach(function (s) {\\n        s.classList.remove('is-active');\\n        s.removeAttribute('aria-current');\\n      });\\n      item.classList.add('is-active');\\n      item.setAttribute('aria-current', 'page');\\n    });\\n  });\\n\\n  document.getElementById('newSession').addEventListener('click', function () {\\n    showToast('新会话已创建（原型演示）');\\n  });\\n\\n  var search = document.getElementById('sessionSearch');\\n  search.addEventListener('input', function () {\\n    var q = search.value.trim().toLowerCase();\\n    var groups = document.querySelectorAll('.session-group');\\n    sessions.forEach(function (item) {\\n      var title = item.querySelector('.session-title').textContent.toLowerCase();\\n      item.hidden = q !== '' && title.indexOf(q) === -1;\\n    });\\n    groups.forEach(function (group) {\\n      var visible = Array.prototype.some.call(group.querySelectorAll('.session'), function (s) {\\n        return !s.hidden;\\n      });\\n      group.hidden = !visible;\\n    });\\n  });\\n\\n  /* ---------- approval ---------- */\\n  approvalCard.querySelectorAll('[data-decision]').forEach(function (btn) {\\n    btn.addEventListener('click', function () {\\n      var decision = btn.getAttribute('data-decision');\\n      approvalPending = false;\\n      approvalCard.classList.add('is-resolved');\\n      if (decision === 'approve') {\\n        approvalStatus.textContent = '已批准';\\n        approvalStatus.className = 'status-chip is-ok';\\n        resolvedText.textContent = '已批准，周报已发送到 #support-weekly。';\\n        showToast('已批准并发送到 #support-weekly');\\n      } else {\\n        approvalStatus.textContent = '已拒绝';\\n        approvalStatus.className = 'status-chip';\\n        resolvedText.textContent = '已拒绝，main-agent 不会发送这条消息。';\\n        showToast('已拒绝本次发送');\\n      }\\n      updateSendState();\\n    });\\n  });\\n\\n  /* ---------- cancel task ---------- */\\n  var cancelBtn = document.querySelector('[data-cancel-task]');\\n  if (cancelBtn) {\\n    cancelBtn.addEventListener('click', function () {\\n      cancelBtn.disabled = true;\\n      cancelBtn.textContent = '正在取消…';\\n      setTimeout(function () {\\n        cancelBtn.textContent = '已取消';\\n        showToast('任务 task_7c1e 已取消');\\n      }, 700);\\n    });\\n  }\\n\\n  /* ---------- composer ---------- */\\n  function autoGrow() {\\n    input.style.height = 'auto';\\n    input.style.height = Math.min(input.scrollHeight, 168) + 'px';\\n  }\\n\\n  function updateSendState() {\\n    var hasText = input.value.trim().length > 0;\\n    sendBtn.classList.toggle('is-disabled', !hasText || approvalPending);\\n    sendBtn.disabled = !hasText || approvalPending;\\n    sendBtn.title = approvalPending ? '请先处理上方的发送审批' : '发送';\\n  }\\n\\n  input.addEventListener('input', function () {\\n    autoGrow();\\n    updateSendState();\\n  });\\n\\n  input.addEventListener('keydown', function (event) {\\n    if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {\\n      event.preventDefault();\\n      send();\\n    }\\n  });\\n\\n  sendBtn.addEventListener('click', send);\\n\\n  function nowTime() {\\n    var d = new Date();\\n    return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');\\n  }\\n\\n  function makeEntry(className, who, whoSub, bodyHTML) {\\n    var li = document.createElement('li');\\n    li.className = 'entry ' + className;\\n    li.innerHTML =\\n      '<span class=\\\"node\\\" aria-hidden=\\\"true\\\"></span>' +\\n      '<div class=\\\"entry-head\\\">' +\\n        '<span class=\\\"who\\\"></span>' +\\n        '<span class=\\\"who-sub\\\"></span>' +\\n        '<span class=\\\"spacer\\\"></span>' +\\n        '<time></time>' +\\n      '</div>' +\\n      '<div class=\\\"entry-body\\\"></div>';\\n    li.querySelector('.who').textContent = who;\\n    li.querySelector('.who-sub').textContent = whoSub;\\n    li.querySelector('time').textContent = nowTime();\\n    li.querySelector('.entry-body').innerHTML = bodyHTML;\\n    return li;\\n  }\\n\\n  function scrollToBottom() {\\n    stream.scrollTop = stream.scrollHeight;\\n  }\\n\\n  function send() {\\n    var text = input.value.trim();\\n    if (!text) return;\\n    if (approvalPending) {\\n      showToast('请先处理上方的发送审批');\\n      return;\\n    }\\n\\n    var bubble = document.createElement('p');\\n    bubble.className = 'prompt-bubble';\\n    bubble.textContent = text;\\n    var userEntry = makeEntry('entry-user', '你', '通过 Web 工作台', '');\\n    userEntry.querySelector('.entry-body').appendChild(bubble);\\n    thread.appendChild(userEntry);\\n\\n    input.value = '';\\n    autoGrow();\\n    updateSendState();\\n    scrollToBottom();\\n\\n    var reply = makeEntry(\\n      'entry-assistant',\\n      'main-agent',\\n      '调度员',\\n      '<div class=\\\"prose\\\"><p class=\\\"typing\\\" aria-label=\\\"正在生成\\\">· · ·</p></div>'\\n    );\\n    thread.appendChild(reply);\\n    scrollToBottom();\\n\\n    setTimeout(function () {\\n      reply.querySelector('.entry-body').innerHTML =\\n        '<div class=\\\"prose\\\"><p>收到，我会把这条补充并入周报，并在下一次发送前再次向你确认。</p></div>';\\n      scrollToBottom();\\n    }, 1300);\\n  }\\n\\n  updateSendState();\\n  autoGrow();\\n})();\\n</script>\\n</body>\\n</html>\\n\"}"}}
