     flex-direction:row;justify-content:space-around;align-items:stretch;\n1047:     margin:0;width:100%;gap:0;\n1048:   }\n1049:   .rail-item{width:auto;flex:1;justify-content:center;padding:6px 0 5px;gap:3px;border-radius:0}\n1050:   .rail-item .ic{width:19px;height:19px}\n1051:   .rail-item.is-active{background:transparent;color:var(--amber)}\n1052:   .rail-item.is-active::before{left:50%;top:0;bottom:auto;transform:translateX(-50%);width:20px;height:2px}\n1053:   .chat{padding-bottom:58px}\n1054:   .chat-head{min-height:60px}\n1055:   .chat-sub .sep,.chat-sub .mono{display:none}\n1056:   .chat-actions .status-chip{display:none}\n1057:   .stream-inner{padding:18px 14px 10px}\n1058:   .entry{padding-left:38px}\n1059:   .thread::before{left:15px}\n1060:   .node{left:11.5px}\n1061:   .thread-foot{margin-left:38px}\n1062:   .composer-wrap{padding:6px 10px 10px}\n1063:   .composer-hint{display:none}\n1064:   .trace{width:min(340px,88vw);top:60px;bottom:58px}\n1065:   .tool-args{display:none}\n1066:   .data-table{font-size:12px}\n1067:   .prose h3{font-size:17px}\n1068: }\n1069: \n1070: \n1071: /* ============================================================\n1072:    v2 components\n1073:    ============================================================ */\n1074: \n1075: /* turns */\n1076: .turn + .turn{margin-top:30px}\n1077: \n1078: /* process cards: tool / vector search */\n1079: .entry-proc{margin-bottom:14px}\n1080: .entry-proc .node{border-radius:2px}\n1081: .kind{\n1082:   display:inline-flex;align-items:center;justify-content:center;flex:none;\n1083:   height:17px;padding:0 5px;\n1084:   border:1px solid var(--line);\n1085:   border-radius:3px;\n1086:   background:var(--surface-2);\n1087:   color:var(--ink-3);\n1088:   font-size:9.5px;font-weight:500;\n1089:   letter-spacing:.02em;\n1090:   white-space:nowrap;\n1091: }\n1092: .kind-tool .node{border-color:var(--amber);background:var(--surface)}\n1093: .kind-vector .node{border-color:var(--prussian);background:var(--prussian-soft)}\n1094: .kind-tool .tool-card{border-left:2px solid var(--amber)}\n1095: .kind-vector .tool-card{border-left:2px solid var(--prussian)}\n1096: .tool-card summary{gap:8px}\n1097: .vector-meta{\n1098:   padding-bottom:5px;\n1099:   font-family:var(--font-mono);\n1100:   font-size:9.5px;color:var(--ink-3);\n1101: }\n1102: .vhit{padding:6px 0;border-bottom:1px dashed var(--line-2);font-size:12px}\n1103: .vhit:last-of-type{border-bottom:0}\n1104: .vhit-main{display:flex;align-items:baseline;gap:8px}\n1105: .vhit-title{flex:1;min-width:0;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n1106: .vhit-score{font-family:var(--font-mono);font-size:10.5px;color:var(--prussian)}\n1107: .vhit-sub{\n1108:   margin-top:2px;\n1109:   font-family:var(--font-mono);\n1110:   font-size:9.5px;color:var(--ink-3);\n1111: }\n1112: \n1113: /* A2A delegation group */\n1114: .delegation{\n1115:   border:1px solid var(--line);\n1116:   border-left:3px solid var(--prussian);\n1117:   border-radius:6px;\n1118:   background:var(--surface);\n1119:   box-shadow:var(--shadow-sm);\n\n(Showing lines 1000-1119 of 2076. Use offset=1120 to continue.)\n</content>"}],"isError":false,"id":"e7dfb3c3-11f3-4dce-9bb0-8b530ec67184"},"meta":{"path":"/home/zhaodan/work/NodeJsProjects/agent-hub-web/docs/prototypes/ui-v4.html","offset":1000,"lines":[{"number":1000,"text":"  50%{opacity:.4}"},{"number":1001,"text":"}"},{"number":1002,"text":""},{"number":1003,"text":"/* ---------- responsive ---------- */"},{"number":1004,"text":"@media (max-width:1280px){"},{"number":1005,"text":"  :root{--sessions-w:264px;--trace-w:304px}"},{"number":1006,"text":"  .stream-inner{padding:26px 28px 14px}"},{"number":1007,"text":"  .composer-wrap{padding:8px 24px 12px}"},{"number":1008,"text":"  .chat-head{padding:0 24px}"},{"number":1009,"text":"}"},{"number":1010,"text":""},{"number":1011,"text":"@media (max-width:1180px){"},{"number":1012,"text":"  .app{grid-template-columns:var(--nav-w) v