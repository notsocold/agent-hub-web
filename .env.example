# 复制为 .env.local 使用；Vite 只暴露 VITE_ 前缀变量给客户端。

# 后端 API 基地址；开发环境留空走 vite proxy
VITE_API_BASE_URL=
# 是否启用内置 mock（true/false）。开发默认在 .env.development 开启。
VITE_USE_MOCK=true
# 页面标题
VITE_APP_TITLE=Agent Hub
# 是否显示调试面板（开发环境可开）
VITE_DEBUG=false

# 可选上报端点：留空即关闭。只上报错误码/request_id/耗时与 Web Vitals，
# 不上报 token、消息正文、附件内容或审批 payload。
VITE_ERROR_REPORT_ENDPOINT=
VITE_PERF_ENDPOINT=
